</div>

<div id="blazor-error-ui">
    Ein unerwarteter Fehler ist aufgetreten.
    <a href="" class="reload text-cyan fw-bold">Neu laden</a>
    <a class="dismiss">🗙</a>
</div>

@code {
    [Inject] private IJSRuntime JS { get; set; } = default!;
    private GlobalStatsDto Stats { get; set; } = new();
    private bool IsLightMode { get; set; }

    protected override void OnInitialized()
    {
        Stats = StatsService.GetStats();
        StatsService.OnStatsChanged += OnStatsUpdated;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                var theme = await JS.InvokeAsync<string>("ImaginarySite.getTheme");
                IsLightMode = theme == "light";
                StateHasChanged();
            }
            catch { /* SSR fallback */ }
        }
    }

    private async Task ToggleThemeAsync()
    {
        try
        {
            var next = await JS.InvokeAsync<string>("ImaginarySite.toggleTheme");
            IsLightMode = next == "light";
        }
        catch { /* Fallback */ }
    }

    private void OnStatsUpdated(GlobalStatsDto updated)
    {
        Stats = updated;
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        StatsService.OnStatsChanged -= OnStatsUpdated;
    }
}
