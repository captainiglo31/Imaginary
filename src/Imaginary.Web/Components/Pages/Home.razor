@page "/"
@using Imaginary.Core.Models
@using Imaginary.Core.Services
@using Imaginary.Web.Services
@rendermode InteractiveServer
@inject IBatchProcessor BatchProcessor
@inject IImageFormatDetector FormatDetector
@inject TempFileStorageService TempStorage
@inject IPresetManager PresetManager
@inject GlobalStatsService StatsService
@inject IJSRuntime JS
@implements IDisposable

<PageTitle>Imaginary – Schneller Bild-Konverter &amp; Editor für Windows &amp; Web</PageTitle>

<!-- =========================================================================
     1. HERO SECTION
     ========================================================================= -->
<section class="hero-section text-center">
    <div class="container-xl">
        <!-- New Release Pill -->
        <div class="mb-4">
            <span class="hero-pill">
                <span class="badge bg-primary text-white rounded-pill px-2 py-1 me-2 fw-bold">v2.5.0</span>
                <span>Neu: Icon-Studio, KI-Upscaling 2x/4x, Social-Media-Vorlagen, Auto-DSGVO &amp; HEIC/HEIF</span>
            </span>
        </div>

        <!-- Interactive Logo Experience -->
        <div class="hero-logo-container" @onclick="TriggerLogoBurst">
            <img id="hero-interactive-logo"
                 src="images/logo.png"
                 alt="Imaginary Logo"
                 class="hero-interactive-logo" />
            <span class="floating-pill floating-pill-left">⚡ SkiaSharp Engine</span>
            <span class="floating-pill floating-pill-right">🛡️ 100% Offline</span>
        </div>

        <!-- Headline -->
        <h1 class="hero-title mb-3">
            Bilder konvertieren &amp; bearbeiten.<br />
            <span class="gradient-text">Ohne Cloud. Ohne Limits. Blitzschnell.</span>
        </h1>

        <!-- Subtitle -->
        <p class="hero-subtitle">
            Das professionelle Schweizer Taschenmesser für deine Bilder. Nutze den schnellen Web-Konverter direkt im Browser oder lade die kostenlose Windows Desktop-App für maximale Leistung, KI-Freistellung und Explorer-Integration herunter.
        </p>

        <!-- CTA Buttons -->
        <div class="d-flex flex-wrap justify-content-center align-items-center gap-3 mb-5">
            <a href="#web-converter" class="btn btn-emerald-glow px-4 py-3 fw-bold fs-5 rounded-3">
                <span class="me-2">⚡</span> Web-Konverter starten
            </a>
            <a href="/download" class="btn btn-primary-glow px-4 py-3 fw-bold fs-5 rounded-3">
                <span class="me-2">📥</span> Windows-App laden (v2.5.0)
            </a>
            <a href="/download/zip" class="btn btn-glass px-3 py-3 fw-semibold rounded-3 text-secondary" title="Als portable ZIP-Datei herunterladen">
                📦 Portable ZIP
            </a>
        </div>

        <!-- Trust Badges Bar -->
        <div class="row justify-content-center g-3 pt-2">
            <div class="col-auto">
                <div class="d-flex align-items-center small text-secondary">
                    <span class="text-emerald me-2 fw-bold">✓</span> 100% Offline-fähig
                </div>
            </div>
            <div class="col-auto">
                <div class="d-flex align-items-center small text-secondary">
                    <span class="text-emerald me-2 fw-bold">✓</span> Keine Cloud-Speicherung
                </div>
            </div>
            <div class="col-auto">
                <div class="d-flex align-items-center small text-secondary">
                    <span class="text-emerald me-2 fw-bold">✓</span> 100% DSGVO-konform
                </div>
            </div>
            <div class="col-auto">
                <div class="d-flex align-items-center small text-secondary">
                    <span class="text-emerald me-2 fw-bold">✓</span> Kostenlos &amp; Open Source
                </div>
            </div>
        </div>
    </div>
</section>

<!-- =========================================================================
     2. LIVE STATS SHOWCASE SECTION
     ========================================================================= -->
<section id="stats" class="py-4 anim-on-scroll">
    <div class="container-xl">
        <div class="row g-3">
            <div class="col-6 col-lg-3">
                <div class="stat-counter-card">
                    <div class="stat-counter-number text-cyan">@Stats.ConvertedCount.ToString("N0")</div>
                    <div class="stat-counter-label">Bilder konvertiert</div>
                </div>
            </div>
            <div class="col-6 col-lg-3">
                <div class="stat-counter-card">
                    <div class="stat-counter-number text-indigo">@Stats.EditedCount.ToString("N0")</div>
                    <div class="stat-counter-label">Im Studio bearbeitet</div>
                </div>
            </div>
            <div class="col-6 col-lg-3">
                <div class="stat-counter-card">
                    <div class="stat-counter-number text-emerald">@Stats.SavedMegaBytes.ToString("N1") MB</div>
                    <div class="stat-counter-label">Eingespartes Volumen</div>
                </div>
            </div>
            <div class="col-6 col-lg-3">
                <div class="stat-counter-card">
                    <div class="stat-counter-number text-white">@Stats.TotalActions.ToString("N0")</div>
                    <div class="stat-counter-label">Aktionen weltweit</div>
                </div>
            </div>
        </div>
        <div class="text-center mt-3">
            <small class="text-muted d-inline-flex align-items-center">
                <span class="pulse-dot me-2"></span>
                Echtzeit-Zähler: Aktualisiert sich automatisch bei jeder Konvertierung &amp; Bearbeitung weltweit.
            </small>
        </div>
    </div>
</section>

<!-- =========================================================================
     3. INTERACTIVE WEB CONVERTER SECTION
     ========================================================================= -->
<section id="web-converter" class="py-5 anim-on-scroll">
    <div class="container-xl">
        <!-- Section Header -->
        <div class="text-center mb-4">
            <span class="badge bg-primary-subtle text-cyan border border-info-subtle px-3 py-1 mb-2 fw-semibold">
                In-Browser Engine
            </span>
            <h2 class="h2 fw-bold text-white mb-2">⚡ Schneller Web-Konverter</h2>
            <p class="text-secondary small mb-0">
                Wähle deine Bilder aus, passe Zielformat und Skalierung an und lade die optimierten Dateien einzeln oder als ZIP herunter.
            </p>
        </div>

        <div class="row g-4">
            <!-- Left: Options Panel -->
            <div class="col-lg-4">
                <div class="glass-card p-4 h-100">
                    <h5 class="fw-bold text-white mb-3 d-flex align-items-center">
                        <span class="me-2">⚙️</span> Konvertierungs-Optionen
                    </h5>

                    <!-- Presets -->
                    <div class="mb-3 p-3 rounded-3" style="background: rgba(255,255,255,0.03); border: 1px solid var(--border-glass);">
                        <label class="form-label text-cyan mb-1">⚡ Schnellauswahl (Profile)</label>
                        <select class="form-select form-select-sm" @onchange="OnPresetChanged">
                            <option value="">-- Eigenes Setup / Profil wählen --</option>
                            @foreach (var preset in AvailablePresets)
                            {
                                <option value="@preset.Id">@preset.Name</option>
                            }
                        </select>
                    </div>

                    <!-- Format & Metadata -->
                    <div class="mb-3">
                        <label class="form-label">1. Zielformat &amp; Metadaten</label>
                        <select class="form-select mb-2" @bind="SelectedFormatString">
                            <option value="">Originalformat beibehalten</option>
                            <option value="Webp">WebP (.webp) – Modern &amp; klein</option>
                            <option value="Avif">AVIF (.avif) – Maximale Kompression</option>
                            <option value="Jpeg">JPEG (.jpg) – Standard</option>
                            <option value="Png">PNG (.png) – Verlustfrei</option>
                            <option value="Ico">Windows Icon (.ico) – Multi-Size</option>
                            <option value="Gif">GIF (.gif)</option>
                            <option value="Bmp">BMP (.bmp)</option>
                        </select>
                        <div class="form-check form-switch">
                            <input class="form-check-input" type="checkbox" id="stripMetaCheck" @bind="StripMetadata">
                            <label class="form-check-label small text-secondary" for="stripMetaCheck">EXIF &amp; GPS Metadaten entfernen</label>
                        </div>
                    </div>

                    <!-- Size Limit -->
                    <div class="mb-3 p-3 rounded-3" style="background: rgba(255,255,255,0.03); border: 1px solid var(--border-glass);">
                        <div class="form-check form-switch mb-2">
                            <input class="form-check-input" type="checkbox" id="sizeLimitSwitch" @bind="EnableSizeLimit">
                            <label class="form-check-label fw-semibold text-white" for="sizeLimitSwitch">2. Dateigröße deckeln</label>
                        </div>

                        @if (EnableSizeLimit)
                        {
                            <div class="input-group mb-2">
                                <input type="number" class="form-control" @bind="SizeLimitValue" min="1" step="any" placeholder="z. B. 500" />
                                <select class="form-select" style="max-width: 90px;" @bind="SizeLimitUnit">
                                    <option value="KB">KB</option>
                                    <option value="MB">MB</option>
                                </select>
                            </div>

                            <label class="form-label text-muted small mb-1">Fallback bei PNG (verlustfrei):</label>
                            <select class="form-select form-select-sm" @bind="SelectedFallbackStrategy">
                                <option value="@FallbackStrategy.ResizeDown">Auflösung reduzieren (Resize)</option>
                                <option value="@FallbackStrategy.Quantize">Farbreduktion (Quantisierung)</option>
                                <option value="@FallbackStrategy.WarnOnly">Nur warnen (kein Eingriff)</option>
                            </select>
                        }
                    </div>

                    <!-- Resizing -->
                    <div class="mb-3 p-3 rounded-3" style="background: rgba(255,255,255,0.03); border: 1px solid var(--border-glass);">
                        <label class="form-label mb-2">3. Auflösung &amp; Skalierung</label>
                        <select class="form-select mb-2" @bind="SelectedResizeMode">
                            <option value="@ResizeMode.None">Keine Skalierung</option>
                            <option value="@ResizeMode.Percentage">Prozentual skalieren (z. B. 50%)</option>
                            <option value="@ResizeMode.AbsolutePixels">Pixelmaße (Breite / Höhe)</option>
                            <option value="@ResizeMode.Pad">Einpassen mit Rand (Pad)</option>
                            <option value="@ResizeMode.FillCrop">Füllen &amp; Beschneiden (FillCrop)</option>
                            <option value="@ResizeMode.MaxEdge">Maximale Kantenlänge (MaxEdge)</option>
                            <option value="@ResizeMode.AiUpscale2x">✨ KI-Upscaling 2x (Super Resolution)</option>
                            <option value="@ResizeMode.AiUpscale4x">✨ KI-Upscaling 4x (Super Resolution)</option>
                        </select>

                        @if (SelectedResizeMode == ResizeMode.Percentage)
                        {
                            <div class="mt-2">
                                <div class="d-flex justify-content-between mb-1 small text-secondary">
                                    <span>Skalierung:</span>
                                    <span class="fw-bold text-cyan">@ResizePercentage%</span>
                                </div>
                                <input type="range" class="form-range" min="5" max="150" step="5" @bind="ResizePercentage" @bind:event="oninput" />
                            </div>
                        }
                        else if (SelectedResizeMode == ResizeMode.AbsolutePixels || SelectedResizeMode == ResizeMode.Pad || SelectedResizeMode == ResizeMode.FillCrop)
                        {
                            <div class="row g-2 mt-1">
                                <div class="col-6">
                                    <label class="form-label small mb-1">Breite (px):</label>
                                    <input type="number" class="form-control form-control-sm" @bind="TargetWidth" placeholder="1920" />
                                </div>
                                <div class="col-6">
                                    <label class="form-label small mb-1">Höhe (px):</label>
                                    <input type="number" class="form-control form-control-sm" @bind="TargetHeight" placeholder="1080" />
                                </div>
                                <div class="col-12 mt-2">
                                    <div class="form-check">
                                        <input class="form-check-input" type="checkbox" id="aspectRatioCheck" @bind="MaintainAspectRatio">
                                        <label class="form-check-label small text-secondary" for="aspectRatioCheck">Seitenverhältnis beibehalten</label>
                                    </div>
                                </div>
                            </div>
                        }
                        else if (SelectedResizeMode == ResizeMode.MaxEdge)
                        {
                            <div class="mt-2">
                                <label class="form-label small mb-1">Längste Kante (px):</label>
                                <input type="number" class="form-control form-control-sm" @bind="MaxEdgeLength" placeholder="1200" />
                            </div>
                        }
                        else if (SelectedResizeMode == ResizeMode.AiUpscale2x || SelectedResizeMode == ResizeMode.AiUpscale4x)
                        {
                            <div class="alert alert-info py-2 small mb-0 mt-2 border-0" style="background: rgba(99, 102, 241, 0.15); color: #c7d2fe;">
                                <strong>✨ Super Resolution:</strong> Verdoppelt oder vervierfacht Auflösung und Schärfe mit Kantenglättung und Detail-Rekonstruktion.
                            </div>
                        }
                    </div>

                    <!-- Watermark -->
                    <div class="mb-3 p-3 rounded-3" style="background: rgba(255,255,255,0.03); border: 1px solid var(--border-glass);">
                        <div class="form-check form-switch mb-2">
                            <input class="form-check-input" type="checkbox" id="watermarkSwitch" @bind="EnableWatermark">
                            <label class="form-check-label fw-semibold text-white" for="watermarkSwitch">4. Wasserzeichen</label>
                        </div>

                        @if (EnableWatermark)
                        {
                            <div class="mb-2">
                                <label class="form-label small mb-1">Text:</label>
                                <input type="text" class="form-control form-control-sm" @bind="WatermarkText" placeholder="© Imaginary" />
                            </div>
                            <div class="row g-2">
                                <div class="col-6">
                                    <label class="form-label small mb-1">Position:</label>
                                    <select class="form-select form-select-sm" @bind="SelectedWatermarkPosition">
                                        <option value="@WatermarkPosition.BottomRight">Unten rechts</option>
                                        <option value="@WatermarkPosition.BottomLeft">Unten links</option>
                                        <option value="@WatermarkPosition.Center">Zentriert</option>
                                        <option value="@WatermarkPosition.TopRight">Oben rechts</option>
                                        <option value="@WatermarkPosition.TopLeft">Oben links</option>
                                    </select>
                                </div>
                                <div class="col-6">
                                    <label class="form-label small mb-1">Deckkraft:</label>
                                    <select class="form-select form-select-sm" @bind="WatermarkOpacityString">
                                        <option value="0.25">25%</option>
                                        <option value="0.5">50%</option>
                                        <option value="0.75">75%</option>
                                        <option value="1.0">100%</option>
                                    </select>
                                </div>
                            </div>
                        }
                    </div>

                    <!-- Auto-DSGVO Redaction -->
                    <div class="mb-3 p-3 rounded-3" style="background: rgba(255,255,255,0.03); border: 1px solid var(--border-glass);">
                        <div class="form-check form-switch mb-2">
                            <input class="form-check-input" type="checkbox" id="autoRedactSwitch" @bind="EnableAutoRedaction">
                            <label class="form-check-label fw-semibold text-white" for="autoRedactSwitch">5. 🤖 Auto-DSGVO (Verpixeln)</label>
                        </div>

                        @if (EnableAutoRedaction)
                        {
                            <div class="mb-2">
                                <div class="form-check mb-1">
                                    <input class="form-check-input" type="checkbox" id="redactFacesCheck" @bind="RedactFaces">
                                    <label class="form-check-label small text-secondary" for="redactFacesCheck">👤 Gesichter automatisch verpixeln</label>
                                </div>
                                <div class="form-check mb-2">
                                    <input class="form-check-input" type="checkbox" id="redactPlatesCheck" @bind="RedactLicensePlates">
                                    <label class="form-check-label small text-secondary" for="redactPlatesCheck">🚗 Kfz-Kennzeichen verpixeln</label>
                                </div>
                                <label class="form-label small mb-1 text-secondary">Anonymisierungs-Stil:</label>
                                <select class="form-select form-select-sm" @bind="SelectedRedactionStyle">
                                    <option value="@RedactionStyle.Pixelate">Verpixeln (Mosaik)</option>
                                    <option value="@RedactionStyle.Blur">Weichzeichnen (Gaußscher Blur)</option>
                                    <option value="@RedactionStyle.Blackout">Schwärzen (Volle Deckung)</option>
                                </select>
                            </div>
                        }
                    </div>

                    <!-- Action Buttons -->
                    <div class="d-grid gap-2 pt-2">
                        <button class="btn btn-emerald-glow py-3 fw-bold fs-6"
                                @onclick="StartConversionAsync"
                                disabled="@(Files.Count == 0 || IsBusy)">
                            @(IsBusy ? "⚙️ Verarbeite Bilder..." : "🚀 Konvertierung starten")
                        </button>

                        @if (!string.IsNullOrEmpty(ZipDownloadUrl))
                        {
                            <a class="btn btn-primary-glow py-2 fw-semibold" href="@ZipDownloadUrl" download="imaginary_all_images.zip">
                                📦 Alle als ZIP herunterladen
                            </a>
                        }

                        @if (Files.Count > 0 && !IsBusy)
                        {
                            <button class="btn btn-glass btn-sm text-secondary" @onclick="ResetList">
                                🔄 Liste leeren &amp; neu beginnen
                            </button>
                        }
                    </div>
                </div>
            </div>

            <!-- Right: Upload Dropzone & Results Table -->
            <div class="col-lg-8">
                <!-- Upload Dropzone -->
                <div class="upload-dropzone mb-4">
                    <span class="upload-icon">📸</span>
                    <h4 class="fw-bold text-white mb-2">Bilder hierher ziehen oder auswählen</h4>
                    <p class="text-secondary small mb-3">
                        Unterstützt JPEG, PNG, WebP, AVIF, BMP, GIF, TIFF und Apple HEIC/HEIF (Mehrfachauswahl möglich).
                    </p>

                    <div class="d-flex justify-content-center">
                        <div style="max-width: 420px; width: 100%;">
                            <InputFile OnChange="HandleFileSelected" multiple class="form-control" accept="image/*,.tiff,.tif,.bmp,.heic,.heif" disabled="@IsBusy" />
                        </div>
                    </div>

                    @if (UploadMessage != null)
                    {
                        <div class="alert alert-info mt-3 py-2 small mb-0 border-0" style="background: rgba(56, 189, 248, 0.15); color: #bae6fd;">
                            @UploadMessage
                        </div>
                    }
                </div>

                <!-- Progress Bar -->
                @if (IsBusy || ProgressValue > 0)
                {
                    <div class="glass-card p-3 mb-4">
                        <div class="d-flex justify-content-between small text-secondary mb-2">
                            <span class="text-cyan fw-semibold">@StatusText</span>
                            <span class="font-mono fw-bold text-white">@ProgressValue%</span>
                        </div>
                        <div class="progress" style="height: 10px; background: rgba(255,255,255,0.08); border-radius: 999px;">
                            <div class="progress-bar progress-bar-striped progress-bar-animated bg-info"
                                 role="progressbar"
                                 style="width: @ProgressValue%; background: linear-gradient(90deg, #0284c7 0%, #38bdf8 100%) !important;"></div>
                        </div>
                    </div>
                }

                <!-- Results List -->
                @if (Files.Count > 0)
                {
                    <div class="glass-card overflow-hidden">
                        <div class="p-3 border-bottom d-flex justify-content-between align-items-center" style="border-color: var(--border-glass) !important;">
                            <span class="fw-bold text-white">Dateien (@Files.Count)</span>
                            @if (!string.IsNullOrEmpty(SummaryStats))
                            {
                                <span class="badge bg-success-subtle text-emerald border border-success-subtle px-3 py-1 font-mono">
                                    @SummaryStats
                                </span>
                            }
                        </div>
                        <div class="table-responsive">
                            <table class="table table-dark-custom align-middle mb-0">
                                <thead>
                                    <tr>
                                        <th>Status</th>
                                        <th>Dateiname</th>
                                        <th>Original</th>
                                        <th>Ergebnis</th>
                                        <th>Ersparnis</th>
                                        <th class="text-end">Aktion</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var file in Files)
                                    {
                                        <tr>
                                            <td>
                                                @if (file.IsProcessing)
                                                {
                                                    <span class="badge bg-warning text-dark">In Arbeit...</span>
                                                }
                                                else if (file.IsDone)
                                                {
                                                    <span class="badge bg-success text-white">✓ Fertig</span>
                                                }
                                                else if (file.IsFailed)
                                                {
                                                    <span class="badge bg-danger">Fehler</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-secondary">Bereit</span>
                                                }
                                            </td>
                                            <td class="fw-semibold text-white">
                                                @file.FileName
                                                @if (file.Warnings.Count > 0)
                                                {
                                                    <div class="small text-warning" title="@string.Join("; ", file.Warnings)">
                                                        ⚠️ @string.Join("; ", file.Warnings)
                                                    </div>
                                                }
                                                @if (!string.IsNullOrEmpty(file.ErrorMessage))
                                                {
                                                    <div class="small text-danger">@file.ErrorMessage</div>
                                                }
                                            </td>
                                            <td class="small text-secondary font-mono">@FormatBytes(file.OriginalSizeBytes)</td>
                                            <td class="small fw-semibold text-cyan font-mono">
                                                @(file.FinalSizeBytes > 0 ? FormatBytes(file.FinalSizeBytes) : "-")
                                            </td>
                                            <td>
                                                @if (file.SavingsPercentage > 0)
                                                {
                                                    <span class="badge bg-success-subtle text-emerald border border-success-subtle font-mono">
                                                        -@file.SavingsPercentage.ToString("N1") %
                                                    </span>
                                                }
                                                else if (file.IsDone)
                                                {
                                                    <span class="text-muted small">0 %</span>
                                                }
                                                else
                                                {
                                                    <span class="text-muted small">-</span>
                                                }
                                            </td>
                                            <td class="text-end">
                                                @if (!string.IsNullOrEmpty(file.DownloadUrl))
                                                {
                                                    <a href="@file.DownloadUrl" class="btn btn-sm btn-outline-info" download="@file.OutputFileName">
                                                        💾 Download
                                                    </a>
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                }

                <!-- Desktop Upsell Banner -->
                <div class="mt-4 p-4 rounded-3 d-flex flex-column flex-md-row align-items-center justify-content-between"
                     style="background: linear-gradient(135deg, rgba(2, 132, 199, 0.15) 0%, rgba(99, 102, 241, 0.15) 100%); border: 1px solid rgba(56, 189, 248, 0.3);">
                    <div class="mb-3 mb-md-0 pe-md-3">
                        <h6 class="fw-bold text-white mb-1">Du möchtest ganze Ordner mit 10.000 Bildern verarbeiten?</h6>
                        <p class="small text-secondary mb-0">
                            Die <strong>Windows Desktop-App</strong> verarbeitet Bilder bis zu 10x schneller direkt von deiner SSD, bietet 100% Offline-KI-Freistellung und Explorer-Rechtsklick-Menü.
                        </p>
                    </div>
                    <a href="/download" class="btn btn-primary-glow btn-sm fw-semibold text-nowrap px-3 py-2">
                        📥 Desktop-App laden
                    </a>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- =========================================================================
     4. DESKTOP APP SHOWCASE & SPOTLIGHT
     ========================================================================= -->
<section id="desktop-app" class="py-5 anim-on-scroll" style="background: rgba(14, 20, 36, 0.4);">
    <div class="container-xl">
        <div class="text-center mb-5">
            <span class="badge bg-info-subtle text-cyan border border-info-subtle px-3 py-1 mb-2 fw-semibold">
                Windows 10 / 11 Native Power
            </span>
            <h2 class="h2 fw-bold text-white mb-2">Warum die Windows Desktop-App unschlagbar ist</h2>
            <p class="text-secondary max-w-700 mx-auto small">
                Nativ für 64-Bit Windows entwickelt. Nutzt die volle Multi-Core-Power deiner CPU &amp; GPU ohne Browser-Speicherbegrenzung und mit 100% Privatsphäre.
            </p>
        </div>

        <div class="row g-4">
            <!-- Feature 1: AI Cutout -->
            <div class="col-md-6 col-lg-4">
                <div class="glass-card p-4 h-100">
                    <div class="feature-icon-wrapper text-cyan">
                        🎯
                    </div>
                    <h5 class="feature-title">Offline KI-Freistellung &amp; Pinsel</h5>
                    <p class="feature-description">
