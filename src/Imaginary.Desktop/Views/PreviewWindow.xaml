<Window x:Class="Imaginary.Desktop.Views.PreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Imaginary – Vorher / Nachher Vergleich"
        Height="720" Width="1040"
        MinHeight="500" MinWidth="700"
        WindowStartupLocation="CenterOwner"
        Icon="pack://application:,,,/app.ico"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}">
    
    <Window.Resources>
        <!-- Checkerboard brush for transparency preview -->
        <DrawingBrush x:Key="CheckerboardBrush" Viewport="0,0,16,16" ViewportUnits="Absolute" TileMode="Tile">
            <DrawingBrush.Drawing>
                <DrawingGroup>
                    <GeometryDrawing Brush="#1E293B">
                        <GeometryDrawing.Geometry>
                            <RectangleGeometry Rect="0,0,16,16"/>
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                    <GeometryDrawing Brush="#0F172A">
                        <GeometryDrawing.Geometry>
                            <GeometryGroup>
                                <RectangleGeometry Rect="0,0,8,8"/>
                                <RectangleGeometry Rect="8,8,8,8"/>
                            </GeometryGroup>
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                </DrawingGroup>
            </DrawingBrush.Drawing>
        </DrawingBrush>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Top Header & Controls -->
        <Border Grid.Row="0" Background="{DynamicResource SurfaceBackgroundBrush}" 
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                CornerRadius="8" Padding="14,10" Margin="0,0,0,12">
            <DockPanel LastChildFill="True">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                    <!-- Mode Switcher -->
                    <Border Background="{DynamicResource ToolbarBackgroundBrush}" CornerRadius="6"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="4,2" Margin="0,0,12,0">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="RadioSplit" Content="↔️ Split-Slider" IsChecked="True" 
                                         Checked="OnViewModeChanged" Style="{StaticResource ToolbarRadioButtonStyle}" Margin="0,0,4,0"/>
                            <RadioButton x:Name="RadioSideBySide" Content="📑 Nebeneinander" 
                                         Checked="OnViewModeChanged" Style="{StaticResource ToolbarRadioButtonStyle}"/>
                        </StackPanel>
                    </Border>
                    
                    <Button Content="Schließen" Click="OnCloseClicked" Style="{StaticResource ToolbarButtonStyle}"/>
                </StackPanel>

                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="TextFileName" Text="Dateiname.png" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <TextBlock x:Name="TextDetails" Text="Details werden geladen..." FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Main Image Area (Common Container for Zoom & Pan) -->
        <Border Grid.Row="1" Background="{DynamicResource SurfaceBackgroundBrush}" 
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                CornerRadius="8" ClipToBounds="True" SizeChanged="OnContainerSizeChanged"
                MouseWheel="OnContainerMouseWheel"
                MouseDown="OnContainerMouseDown"
                MouseMove="OnContainerMouseMove"
                MouseUp="OnContainerMouseUp"
                LostMouseCapture="OnContainerLostMouseCapture">
            <Grid ClipToBounds="True">
                <!-- Split Slider View Mode -->
                <Grid x:Name="SplitViewGrid" Visibility="Visible" Cursor="SizeWE" Background="{StaticResource CheckerboardBrush}" ClipToBounds="True"
                      MouseDown="OnImageAreaMouseDown" MouseMove="OnImageAreaMouseMove" MouseUp="OnImageAreaMouseUp">
                    <!-- Layer 1: Original Image inside Container with Clip (Left of split) -->
                    <Grid x:Name="OriginalContainer" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" ClipToBounds="True">
                        <Grid.Clip>
                            <RectangleGeometry x:Name="OriginalClipGeometry"/>
                        </Grid.Clip>
                        <Image x:Name="ImageOriginalSplit" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="0,0"/>
                    </Grid>
                    
                    <!-- Layer 2: Processed Image inside a Container matching Grid bounds with Clip (Right of split) -->
                    <Grid x:Name="ProcessedContainer" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" ClipToBounds="True">
                        <Grid.Clip>
                            <RectangleGeometry x:Name="SplitClipGeometry"/>
                        </Grid.Clip>
                        <Image x:Name="ImageProcessedSplit" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="0,0"/>
                    </Grid>

                    <!-- Layer 3: Split line and draggable circle handle -->
                    <Canvas x:Name="SplitOverlayCanvas" IsHitTestVisible="False">
                        <Line x:Name="SplitLine" Stroke="#38BDF8" StrokeThickness="2.5" Y1="0"/>
                        <Border x:Name="SplitHandle" Width="36" Height="36" CornerRadius="18"
                                Background="#38BDF8" BorderBrush="White" BorderThickness="2">
                            <TextBlock Text="↔" Foreground="White" FontWeight="Bold" FontSize="16"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-2,0,0"/>
                        </Border>
                    </Canvas>
                    
                    <!-- Slider Bar at Bottom of Image -->
                    <Border Background="#B0000000" VerticalAlignment="Bottom" HorizontalAlignment="Center"
                            CornerRadius="20" Padding="16,6" Margin="0,0,0,16" Cursor="Arrow">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Vorher" Foreground="White" FontSize="11" FontWeight="SemiBold" Margin="0,0,10,0" VerticalAlignment="Center"/>
                            <Slider x:Name="SplitSlider" Minimum="0" Maximum="100" Value="50" Width="260"
                                    ValueChanged="OnSplitSliderValueChanged" VerticalAlignment="Center"/>
                            <TextBlock Text="Nachher" Foreground="White" FontSize="11" FontWeight="SemiBold" Margin="10,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Side By Side View Mode -->
                <Grid x:Name="SideBySideGrid" Visibility="Collapsed" Margin="8" ClipToBounds="True">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition x:Name="ColOriginal" Width="*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition x:Name="ColProcessed" Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border x:Name="BorderOriginalSide" Grid.Column="0" BorderBrush="{DynamicResource BorderBrush}" 
                            BorderThickness="1" CornerRadius="6" ClipToBounds="True" Background="Transparent">
                        <Grid x:Name="GridOriginalSide" Background="{StaticResource CheckerboardBrush}" ClipToBounds="True">
                            <Image x:Name="ImageOriginalSide" Stretch="Uniform" RenderTransformOrigin="0,0"/>
                            <Border Background="#B0000000" VerticalAlignment="Top" HorizontalAlignment="Left"
                                    CornerRadius="4" Padding="8,3" Margin="8" IsHitTestVisible="False">
                                <TextBlock Text="Original (Vorher)" Foreground="White" FontSize="11" FontWeight="SemiBold"/>
                            </Border>
                        </Grid>
                    </Border>

                    <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Center" Background="{DynamicResource BorderBrush}"/>

                    <Border x:Name="BorderProcessedSide" Grid.Column="2" BorderBrush="{DynamicResource BorderBrush}" 
                            BorderThickness="1" CornerRadius="6" ClipToBounds="True" Background="Transparent">
                        <Grid x:Name="GridProcessedSide" Background="{StaticResource CheckerboardBrush}" ClipToBounds="True">
                            <Image x:Name="ImageProcessedSide" Stretch="Uniform" RenderTransformOrigin="0,0"/>
                            <Border Background="#B0000000" VerticalAlignment="Top" HorizontalAlignment="Left"
                                    CornerRadius="4" Padding="8,3" Margin="8" IsHitTestVisible="False">
                                <TextBlock Text="Konvertiert (Nachher)" Foreground="White" FontSize="11" FontWeight="SemiBold"/>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>

                <!-- Floating Zoom Pill (Top Right) -->
                <Border x:Name="BadgeZoom" Background="#CC0A0E1A" BorderBrush="#38BDF8" BorderThickness="1"
                        CornerRadius="14" Padding="10,4" Margin="14" HorizontalAlignment="Right" VerticalAlignment="Top"
                        Cursor="Hand" MouseLeftButtonDown="OnResetZoomClicked"
                        ToolTip="Mausrad zum Zoomen • Verschieben (Pan) mit linker/rechter Maustaste • Doppelklick zum Zurücksetzen">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="🔍 " FontSize="11" VerticalAlignment="Center"/>
                        <TextBlock x:Name="TextZoomLevel" Text="100%" FontWeight="Bold" FontSize="11.5" Foreground="#38BDF8" VerticalAlignment="Center"/>
                        <TextBlock Text=" (Reset)" FontSize="10" Foreground="#94A3B8" Margin="4,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- Bottom Status / Size Comparison -->
        <Border Grid.Row="2" Background="{DynamicResource SurfaceBackgroundBrush}" 
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                CornerRadius="8" Padding="14,10" Margin="0,12,0,0">
            <DockPanel LastChildFill="True">
                <TextBlock x:Name="TextSavings" Text="Ersparnis: -" FontWeight="Bold" DockPanel.Dock="Right" 
                           Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center"/>
                <TextBlock x:Name="TextHint" Text="Ziehen Sie den Slider oder klicken Sie ins Bild, um Details zu vergleichen." 
                           Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" VerticalAlignment="Center"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
