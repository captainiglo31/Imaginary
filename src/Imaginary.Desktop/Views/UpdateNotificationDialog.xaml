<Window x:Class="Imaginary.Desktop.Views.UpdateNotificationDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Imaginary – Update verfügbar"
        Height="500" Width="580"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Icon="pack://application:,,,/app.ico"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        FontFamily="Segoe UI">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="{DynamicResource SurfaceBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                CornerRadius="8" Padding="16,14" Margin="0,0,0,16">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Image Source="pack://application:,,,/Assets/logo.png" Width="38" Height="38" Margin="0,0,16,0"
                       VerticalAlignment="Center"
                       RenderOptions.BitmapScalingMode="HighQuality"
                       SnapsToDevicePixels="True"/>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="🎉 Neues Update verfügbar!" FontWeight="Bold" FontSize="17"
                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <TextBlock x:Name="TextPrompt"
                               Text="Es ist ein Update auf Version X.Y verfügbar. Möchtest du es jetzt installieren?"
                               FontSize="13" TextWrapping="Wrap"
                               Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Version Comparison Badge -->
        <Border Grid.Row="1" Background="{DynamicResource ToolbarBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                CornerRadius="6" Padding="12,10" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Aktuelle Version" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                    <TextBlock x:Name="TextCurrentVersion" Text="v1.0.0" FontWeight="SemiBold" FontSize="14" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,2,0,0"/>
                </StackPanel>

                <TextBlock Grid.Column="1" Text="➔" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" Margin="12,0"/>

                <StackPanel Grid.Column="2">
                    <TextBlock Text="Verfügbare Version" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                    <TextBlock x:Name="TextLatestVersion" Text="v1.1.0" FontWeight="Bold" FontSize="14" Foreground="#10B981" Margin="0,2,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Release Notes Section -->
        <Border Grid.Row="2" Background="{DynamicResource SurfaceBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                CornerRadius="8" Padding="14,12" Margin="0,0,0,16">
            <DockPanel LastChildFill="True">
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                    <TextBlock Text="✨ Neuerungen &amp; Highlights:" FontWeight="Bold" FontSize="12.5"
                               Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                    <Button x:Name="ButtonOpenGithubRelease" DockPanel.Dock="Right" HorizontalAlignment="Right"
                            Content="🔗 Auf GitHub ansehen" Click="OnOpenGithubReleaseClicked"
                            Padding="8,3" FontSize="11" Background="Transparent" BorderThickness="0"
                            Foreground="{DynamicResource AccentBrush}" Cursor="Hand"
                            ToolTip="Öffnet die vollständigen Release-Notes im Webbrowser"/>
                </DockPanel>

                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="PanelReleaseNotes">
                        <!-- Populated programmatically with formatted items -->
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- Download Progress Section (Collapsible) -->
        <Border Grid.Row="3" x:Name="PanelProgress" Visibility="Collapsed"
                Background="{DynamicResource ToolbarBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                CornerRadius="6" Padding="12,10" Margin="0,0,0,16">
            <StackPanel>
                <DockPanel LastChildFill="True" Margin="0,0,0,6">
                    <TextBlock x:Name="TextProgressPercentage" DockPanel.Dock="Right" Text="0%" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource AccentBrush}"/>
                    <TextBlock x:Name="TextProgressStatus" Text="Wird heruntergeladen..." FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
                </DockPanel>
                <ProgressBar x:Name="ProgressDownload" Height="14" Minimum="0" Maximum="100" Value="0"
                             Foreground="{DynamicResource AccentBrush}"/>
            </StackPanel>
        </Border>

        <!-- Action Buttons -->
        <DockPanel Grid.Row="4" LastChildFill="False">
            <Button DockPanel.Dock="Left" Content="Diese Version überspringen" Click="OnSkipVersionClicked"
                    Padding="10,6" FontSize="12" Background="Transparent" Foreground="{DynamicResource TextSecondaryBrush}"
                    BorderThickness="0" Cursor="Hand" ToolTip="Für diese Versionsnummer nicht mehr nachfragen"/>

            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button x:Name="ButtonLater" Content="Später erinnern" Click="OnLaterClicked"
                        Padding="14,8" FontSize="13" Margin="0,0,10,0"
                        Background="{DynamicResource SecondaryButtonBackgroundBrush}"
                        Foreground="{DynamicResource SecondaryButtonForegroundBrush}"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                        Cursor="Hand"/>

                <Button x:Name="ButtonInstall" Content="🚀 Jetzt installieren" Click="OnInstallClicked"
                        Padding="18,8" FontSize="13" FontWeight="Bold"
                        Background="{DynamicResource ActionButtonGradientBrush}"
                        Foreground="White" BorderThickness="0"
                        Cursor="Hand"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
