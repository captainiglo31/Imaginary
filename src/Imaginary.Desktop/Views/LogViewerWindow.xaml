<Window x:Class="Imaginary.Desktop.Views.LogViewerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Imaginary – System- &amp; Fehler-Protokoll"
        Height="650" Width="1000"
        MinHeight="450" MinWidth="750"
        WindowStartupLocation="CenterOwner"
        Icon="pack://application:,,,/app.ico"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        FontFamily="Segoe UI">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="{DynamicResource SurfaceBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                CornerRadius="8" Padding="14,10" Margin="0,0,0,10">
            <DockPanel LastChildFill="True">
                <Button DockPanel.Dock="Right" Content="Schließen" Click="OnCloseClicked" Padding="14,5"
                        Background="{DynamicResource SecondaryButtonBackgroundBrush}"
                        Foreground="{DynamicResource SecondaryButtonForegroundBrush}"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Cursor="Hand"/>

                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="📋 System- &amp; Fehler-Protokoll" FontWeight="Bold" FontSize="16"
                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <TextBlock Text="Echtzeit-Ereignisse, Stapelverarbeitungsschritte und Diagnosemeldungen" FontSize="12"
                               Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Toolbar / Filters -->
        <Border Grid.Row="1" Background="{DynamicResource ToolbarBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                CornerRadius="6" Padding="10" Margin="0,0,0,10">
            <DockPanel LastChildFill="True">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                    <Button Content="📋 Kopieren" Click="OnCopyClicked" Padding="10,5" Margin="0,0,6,0"
                            Style="{DynamicResource ToolbarButtonStyle}" ToolTip="Alle aktuell gefilterten Einträge in die Zwischenablage kopieren"/>
                    <Button Content="💾 Exportieren..." Click="OnExportClicked" Padding="10,5" Margin="0,0,6,0"
                            Style="{DynamicResource ToolbarButtonStyle}" ToolTip="Protokoll als Textdatei speichern"/>
                    <Button Content="📁 Log-Ordner" Click="OnOpenFolderClicked" Padding="10,5" Margin="0,0,6,0"
                            Style="{DynamicResource ToolbarButtonStyle}" ToolTip="Ordner mit Logdateien im Windows Explorer öffnen"/>
                    <Button Content="🗑️ Leeren" Click="OnClearClicked" Padding="10,5" Margin="0"
                            Style="{DynamicResource ToolbarButtonStyle}" ToolTip="Anzeige und Speicherpuffer leeren"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Filter:" VerticalAlignment="Center" Margin="0,0,8,0" FontWeight="SemiBold"/>
                    <ComboBox x:Name="ComboLogLevel" Width="170" Margin="0,0,14,0" SelectionChanged="OnFilterChanged" Padding="8,4">
                        <ComboBoxItem Content="Alle Stufen (Debug+)"/>
                        <ComboBoxItem Content="Nur Fehler (Error)"/>
                        <ComboBoxItem Content="Warnungen &amp; Fehler"/>
                        <ComboBoxItem Content="Informationen &amp; höher"/>
                    </ComboBox>

                    <TextBlock Text="Suche:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBox x:Name="TextSearch" Width="180" Margin="0,0,14,0" TextChanged="OnSearchTextChanged" Padding="6,4"/>

                    <CheckBox x:Name="CheckAutoScroll" Content="Auto-Scroll" IsChecked="True" VerticalAlignment="Center"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Log Entries DataGrid -->
        <Border Grid.Row="2" Background="{DynamicResource SurfaceBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6">
            <DataGrid x:Name="GridLogs"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      IsReadOnly="True"
                      SelectionMode="Single"
                      HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal"
                      HorizontalGridLinesBrush="{DynamicResource DataGridLinesBrush}"
                      SelectionChanged="OnGridSelectionChanged"
                      Background="{DynamicResource SurfaceBackgroundBrush}"
                      BorderThickness="0">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Zeit" Binding="{Binding FormattedTime}" Width="95"/>
                    
                    <DataGridTemplateColumn Header="Stufe" Width="85">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border CornerRadius="3" Padding="6,2" HorizontalAlignment="Center">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Level}" Value="Error">
                                                    <Setter Property="Background" Value="#DC2626"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Level}" Value="Warning">
                                                    <Setter Property="Background" Value="#D97706"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Level}" Value="Information">
                                                    <Setter Property="Background" Value="#0284C7"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Level}" Value="Debug">
                                                    <Setter Property="Background" Value="#475569"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding Level}" Foreground="White" FontSize="11" FontWeight="Bold"/>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTextColumn Header="Bereich" Binding="{Binding Source}" Width="130"/>
                    <DataGridTextColumn Header="Meldung" Binding="{Binding Message}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- Selected Log Details (Exception StackTrace) -->
        <Grid x:Name="DetailsPanel" Grid.Row="3" Margin="0,10,0,0" Visibility="Collapsed">
            <Border Background="{DynamicResource SurfaceBackgroundBrush}"
                    BorderBrush="#DC2626" BorderThickness="1.5" CornerRadius="6" Padding="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <DockPanel Grid.Row="0" Margin="0,0,0,6">
                        <Button DockPanel.Dock="Right" Content="Details kopieren" Click="OnCopyDetailsClicked"
                                Padding="8,3" FontSize="11" Style="{DynamicResource ToolbarButtonStyle}"/>
                        <TextBlock Text="⚠️ Fehler-Details &amp; Exception Stack Trace:" FontWeight="Bold" Foreground="#EF4444" VerticalAlignment="Center"/>
                    </DockPanel>
                    <TextBox x:Name="TextDetails" Grid.Row="1" MaxHeight="120"
                             FontFamily="Consolas" FontSize="11.5"
                             IsReadOnly="True" TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto" Background="#0A0E1A" Foreground="#F87171" Padding="8"/>
                </Grid>
            </Border>
        </Grid>

        <!-- Status Footer -->
        <Border Grid.Row="4" Background="{DynamicResource SurfaceBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0"
                Padding="8,8,8,0" Margin="0,8,0,0">
            <TextBlock x:Name="TextLogSummary" Text="0 Einträge" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
        </Border>
    </Grid>
</Window>
