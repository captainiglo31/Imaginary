<Window x:Class="Imaginary.Desktop.Views.CanvasResizeDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Leinwandgröße anpassen" Height="520" Width="480"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        FontFamily="Segoe UI, Segoe UI Emoji, Segoe UI Symbol">

    <Window.Resources>
        <Style x:Key="AnchorRadioStyle" TargetType="RadioButton">
            <Setter Property="Width" Value="38"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Border" CornerRadius="6" Background="#1E293B" BorderBrush="#334155" BorderThickness="1.5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                <Setter TargetName="Border" Property="Background" Value="#334155"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="{DynamicResource AccentBrush}"/>
                                <Setter TargetName="Border" Property="BorderBrush" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Margin="0,0,0,16" Padding="0,0,0,12" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
            <DockPanel LastChildFill="True">
                <TextBlock Text="📐" FontSize="24" Margin="0,0,10,0" VerticalAlignment="Center"/>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Leinwandgröße anpassen" FontSize="16" FontWeight="Bold"/>
                    <TextBlock x:Name="TextCurrentDimensions" Text="Aktuelle Größe: 1920 × 1080 px" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Main Body: Tabs for Mode -->
        <TabControl x:Name="TabMode" Grid.Row="1" Background="Transparent" BorderThickness="0">
            <!-- Tab 1: Dimensions -->
            <TabItem Header="📐 Neue Abmessungen" FontWeight="SemiBold">
                <StackPanel Margin="0,14,0,0">
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="40"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Breite:" VerticalAlignment="Center" FontWeight="SemiBold"/>
                        <TextBox x:Name="TextNewWidth" Grid.Column="1" Padding="6,4" TextChanged="OnDimensionsChanged"/>
                        <TextBlock Grid.Column="2" Text="px" Margin="8,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </Grid>

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="40"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Höhe:" VerticalAlignment="Center" FontWeight="SemiBold"/>
                        <TextBox x:Name="TextNewHeight" Grid.Column="1" Padding="6,4" TextChanged="OnDimensionsChanged"/>
                        <TextBlock Grid.Column="2" Text="px" Margin="8,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </Grid>

                    <CheckBox x:Name="CheckKeepAspect" Content="🔗 Seitenverhältnis beibehalten" IsChecked="False" Margin="120,0,0,16" Checked="OnKeepAspectToggled" Unchecked="OnKeepAspectToggled"/>

                    <TextBlock Text="Schnellauswahl:" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,6"/>
                    <WrapPanel Margin="0,0,0,14">
                        <Button Content="2× Breite (Side-by-Side)" Click="OnPresetDoubleWidthClicked" Style="{DynamicResource ToolbarButtonStyle}" Padding="8,4" Margin="0,0,6,6"/>
                        <Button Content="2× Höhe (Untereinander)" Click="OnPresetDoubleHeightClicked" Style="{DynamicResource ToolbarButtonStyle}" Padding="8,4" Margin="0,0,6,6"/>
                        <Button Content="+200 px rundherum" Click="OnPresetPadding200Clicked" Style="{DynamicResource ToolbarButtonStyle}" Padding="8,4" Margin="0,0,6,6"/>
                    </WrapPanel>

                    <!-- Anchor selection -->
                    <TextBlock Text="Ausrichtung / Ankerpunkt:" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <Grid HorizontalAlignment="Left" Margin="0,0,0,14">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <RadioButton x:Name="AnchorTopLeft" Grid.Row="0" Grid.Column="0" Content="↖" IsChecked="True" Style="{StaticResource AnchorRadioStyle}" ToolTip="Oben Links"/>
                        <RadioButton x:Name="AnchorTopCenter" Grid.Row="0" Grid.Column="1" Content="↑" Style="{StaticResource AnchorRadioStyle}" ToolTip="Oben Mitte"/>
                        <RadioButton x:Name="AnchorTopRight" Grid.Row="0" Grid.Column="2" Content="↗" Style="{StaticResource AnchorRadioStyle}" ToolTip="Oben Rechts"/>

                        <RadioButton x:Name="AnchorMiddleLeft" Grid.Row="1" Grid.Column="0" Content="←" Style="{StaticResource AnchorRadioStyle}" ToolTip="Mitte Links"/>
                        <RadioButton x:Name="AnchorCenter" Grid.Row="1" Grid.Column="1" Content="•" Style="{StaticResource AnchorRadioStyle}" ToolTip="Zentriert"/>
                        <RadioButton x:Name="AnchorMiddleRight" Grid.Row="1" Grid.Column="2" Content="→" Style="{StaticResource AnchorRadioStyle}" ToolTip="Mitte Rechts"/>

                        <RadioButton x:Name="AnchorBottomLeft" Grid.Row="2" Grid.Column="0" Content="↙" Style="{StaticResource AnchorRadioStyle}" ToolTip="Unten Links"/>
                        <RadioButton x:Name="AnchorBottomCenter" Grid.Row="2" Grid.Column="1" Content="↓" Style="{StaticResource AnchorRadioStyle}" ToolTip="Unten Mitte"/>
                        <RadioButton x:Name="AnchorBottomRight" Grid.Row="2" Grid.Column="2" Content="↘" Style="{StaticResource AnchorRadioStyle}" ToolTip="Unten Rechts"/>
                    </Grid>

                    <!-- Fill color -->
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Hintergrundfarbe:" VerticalAlignment="Center" FontWeight="SemiBold"/>
                        <ComboBox x:Name="ComboBackground" Grid.Column="1" SelectedIndex="0" Padding="6,4">
                            <ComboBoxItem Content="🏁 Transparent (Schachbrett)"/>
                            <ComboBoxItem Content="⬜ Weiß (wie MS Paint)"/>
                            <ComboBoxItem Content="⬛ Schwarz"/>
                            <ComboBoxItem Content="🎨 Dunkelgrau (#111827)"/>
                        </ComboBox>
                    </Grid>
                </StackPanel>
            </TabItem>

            <!-- Tab 2: Padding -->
            <TabItem Header="➕ Rand hinzufügen (Padding)" FontWeight="SemiBold">
                <StackPanel Margin="0,14,0,0">
                    <TextBlock Text="Zusätzliche Pixelränder um das Bild herum:" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,14"/>

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="40"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Oben:" VerticalAlignment="Center" FontWeight="SemiBold"/>
                        <TextBox x:Name="TextPadTop" Grid.Column="1" Text="0" Padding="6,4" TextChanged="OnPaddingChanged"/>
                        <TextBlock Grid.Column="2" Text="px" Margin="8,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </Grid>

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="40"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Unten:" VerticalAlignment="Center" FontWeight="SemiBold"/>
                        <TextBox x:Name="TextPadBottom" Grid.Column="1" Text="0" Padding="6,4" TextChanged="OnPaddingChanged"/>
                        <TextBlock Grid.Column="2" Text="px" Margin="8,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </Grid>

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="40"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Links:" VerticalAlignment="Center" FontWeight="SemiBold"/>
                        <TextBox x:Name="TextPadLeft" Grid.Column="1" Text="0" Padding="6,4" TextChanged="OnPaddingChanged"/>
                        <TextBlock Grid.Column="2" Text="px" Margin="8,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </Grid>

                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="40"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Rechts:" VerticalAlignment="Center" FontWeight="SemiBold"/>
                        <TextBox x:Name="TextPadRight" Grid.Column="1" Text="0" Padding="6,4" TextChanged="OnPaddingChanged"/>
                        <TextBlock Grid.Column="2" Text="px" Margin="8,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </Grid>

                    <WrapPanel Margin="0,0,0,14">
                        <Button Content="+50 px alle" Click="OnPresetPad50Clicked" Style="{DynamicResource ToolbarButtonStyle}" Padding="8,4" Margin="0,0,6,6"/>
                        <Button Content="+100 px alle" Click="OnPresetPad100Clicked" Style="{DynamicResource ToolbarButtonStyle}" Padding="8,4" Margin="0,0,6,6"/>
                        <Button Content="+200 px rechts" Click="OnPresetPad200RightClicked" Style="{DynamicResource ToolbarButtonStyle}" Padding="8,4" Margin="0,0,6,6"/>
                        <Button Content="+200 px unten" Click="OnPresetPad200BottomClicked" Style="{DynamicResource ToolbarButtonStyle}" Padding="8,4" Margin="0,0,6,6"/>
                    </WrapPanel>

                    <TextBlock x:Name="TextPaddingResultInfo" Text="Neue Größe: 1920 × 1080 px" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}"/>
                </StackPanel>
            </TabItem>
        </TabControl>

        <!-- Footer Buttons -->
        <Border Grid.Row="2" Margin="0,16,0,0" Padding="0,12,0,0" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0">
            <DockPanel LastChildFill="False">
                <Button Content="Abbrechen" IsCancel="True" Style="{DynamicResource ToolbarButtonStyle}" Padding="14,6" DockPanel.Dock="Left"/>
                <Button Content="📐 Leinwand anwenden" IsDefault="True" Click="OnApplyClicked" Background="{DynamicResource AccentBrush}" Foreground="White" FontWeight="Bold" Padding="16,6" DockPanel.Dock="Right" Style="{DynamicResource ToolbarButtonStyle}"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
