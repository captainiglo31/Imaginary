<Window x:Class="Imaginary.Desktop.Views.ScreenCaptureOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Imaginary Screenshot Snipping"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        WindowState="Normal"
        Cursor="Cross"
        Focusable="True"
        KeyDown="OnKeyDown"
        MouseLeftButtonDown="OnMouseLeftButtonDown"
        MouseMove="OnMouseMove"
        MouseLeftButtonUp="OnMouseLeftButtonUp">

    <Grid x:Name="RootGrid" ClipToBounds="True">
        <!-- 1. Background Screenshot of Desktop -->
        <Image x:Name="BackgroundImage" Stretch="Fill"
               RenderOptions.BitmapScalingMode="HighQuality"
               SnapsToDevicePixels="True"/>

        <!-- 2. Dark Shading Path (Everything darkened except selection area) -->
        <Path x:Name="ShadingPath" Fill="#77000000">
            <Path.Data>
                <CombinedGeometry GeometryCombineMode="Exclude">
                    <CombinedGeometry.Geometry1>
                        <RectangleGeometry x:Name="FullShadingGeometry"/>
                    </CombinedGeometry.Geometry1>
                    <CombinedGeometry.Geometry2>
                        <RectangleGeometry x:Name="SelectionExcludeGeometry"/>
                    </CombinedGeometry.Geometry2>
                </CombinedGeometry>
            </Path.Data>
        </Path>

        <!-- 3. Selection Canvas for Border and Badges -->
        <Canvas x:Name="SelectionCanvas">
            <!-- Active Selection Glowing Border -->
            <Border x:Name="SelectionBorder"
                    Visibility="Collapsed"
                    BorderBrush="#00D2FF"
                    BorderThickness="1.5"
                    CornerRadius="1">
                <Border.Effect>
                    <DropShadowEffect Color="#00D2FF" BlurRadius="6" ShadowDepth="0" Opacity="0.8"/>
                </Border.Effect>
            </Border>

            <!-- Dimension Badge (Width x Height px) -->
            <Border x:Name="DimensionBadge"
                    Visibility="Collapsed"
                    Background="#EE0F172A"
                    BorderBrush="#00D2FF"
                    BorderThickness="1"
                    CornerRadius="4"
                    Padding="6,3">
                <Border.Effect>
                    <DropShadowEffect Color="#000000" BlurRadius="4" ShadowDepth="1" Opacity="0.6"/>
                </Border.Effect>
                <TextBlock x:Name="DimensionText"
                           Text="0 × 0 px"
                           Foreground="#F8FAFC"
                           FontSize="11"
                           FontWeight="SemiBold"
                           FontFamily="Segoe UI"/>
            </Border>
        </Canvas>

        <!-- 4. Top Floating Hint Pill -->
        <Border HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,24,0,0"
                Background="#EE0A0E1A" BorderBrush="#38BDF8" BorderThickness="1"
                CornerRadius="20" Padding="18,8">
            <Border.Effect>
                <DropShadowEffect Color="#000000" BlurRadius="12" ShadowDepth="2" Opacity="0.5"/>
            </Border.Effect>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="📸 " FontSize="14" VerticalAlignment="Center"/>
                <TextBlock Text="Bereich mit der Maus aufziehen" FontWeight="SemiBold" Foreground="#FFFFFF" FontSize="13" VerticalAlignment="Center"/>
                <TextBlock Text=" • " Foreground="#64748B" FontSize="13" VerticalAlignment="Center"/>
                <TextBlock Text="ESC" FontWeight="Bold" Foreground="#38BDF8" FontSize="12" VerticalAlignment="Center"/>
                <TextBlock Text=" zum Abbrechen" Foreground="#94A3B8" FontSize="12" VerticalAlignment="Center"/>
                <TextBlock Text=" • " Foreground="#64748B" FontSize="13" VerticalAlignment="Center"/>
                <TextBlock Text="Enter" FontWeight="Bold" Foreground="#10B981" FontSize="12" VerticalAlignment="Center"/>
                <TextBlock Text=" für Vollbild" Foreground="#94A3B8" FontSize="12" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
