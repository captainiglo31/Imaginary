<Window x:Class="Imaginary.Desktop.Views.CrashRecoveryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="🚨 Imaginary – Notfall-Wiederherstellung"
        Height="540" Width="680"
        WindowStartupLocation="CenterScreen"
        Background="#0F172A" Foreground="#F8FAFC"
        FontFamily="Segoe UI, -apple-system, sans-serif"
        ResizeMode="CanResizeWithGrip">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Margin="0,0,0,16" Padding="0,0,0,16" BorderBrush="#334155" BorderThickness="0,0,0,1">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                    <TextBlock Text="🚨" FontSize="26" Margin="0,0,10,0" VerticalAlignment="Center"/>
                    <TextBlock Text="Imaginary konnte nicht normal starten" FontSize="20" FontWeight="Bold" Foreground="#F8FAFC" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock Text="Ein unerwarteter Fehler hat den Start der Benutzeroberfläche verhindert. Du kannst die Anwendung auf die vorherige Version zurücksetzen (Rollback) oder direkt nach einem neuen Hotfix suchen."
                           FontSize="12.5" Foreground="#94A3B8" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <!-- Error Details Box -->
        <Grid Grid.Row="1" Margin="0,0,0,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Text="Fehler-Details:" FontSize="12" FontWeight="SemiBold" Foreground="#CBD5E1" Margin="0,0,0,6"/>
            <Border Grid.Row="1" Background="#020617" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="6" Padding="12">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                    <TextBox x:Name="ErrorTextBox" Background="Transparent" Foreground="#F87171"
                             BorderThickness="0" IsReadOnly="True" TextWrapping="Wrap"
                             FontFamily="Consolas, Cascadia Code, Courier New" FontSize="11.5"/>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- Status & Update Info -->
        <Border Grid.Row="2" x:Name="StatusPanel" Visibility="Collapsed" Background="#1E293B" CornerRadius="6" Padding="12" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock x:Name="StatusTextBlock" Text="Status..." FontSize="12" Foreground="#38BDF8" FontWeight="SemiBold" Margin="0,0,0,4"/>
                <ProgressBar x:Name="DownloadProgressBar" Height="6" Minimum="0" Maximum="100" Background="#0F172A" Foreground="#10B981" Visibility="Collapsed"/>
            </StackPanel>
        </Border>

        <!-- Action Buttons Grid -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Recovery Actions -->
            <StackPanel Grid.Column="0" Orientation="Horizontal">
                <!-- Start Anyway Button -->
                <Button x:Name="StartAnywayButton" Content="🚀 Trotzdem normal starten"
                        Click="OnStartAnywayClicked"
                        Background="#10B981" Foreground="White" FontWeight="Bold" FontSize="12.5"
                        Padding="14,10" Margin="0,0,10,0" BorderThickness="0" Cursor="Hand"
                        ToolTip="Setzt den Crash-Zähler zurück und startet Imaginary normal"/>

                <!-- Rollback Button -->
                <Button x:Name="RollbackButton" Content="⏪ Auf vorherige Version zurück (Rollback)"
                        Click="OnRollbackClicked"
                        Background="#DC2626" Foreground="White" FontWeight="Bold" FontSize="12.5"
                        Padding="14,10" Margin="0,0,10,0" BorderThickness="0" Cursor="Hand"/>

                <!-- Search & Install Update Button -->
                <Button x:Name="CheckUpdateButton" Content="🔄 Online nach Hotfix suchen"
                        Click="OnCheckUpdateClicked"
                        Background="#2563EB" Foreground="White" FontWeight="Bold" FontSize="12.5"
                        Padding="14,10" Margin="0,0,10,0" BorderThickness="0" Cursor="Hand"/>
            </StackPanel>

            <!-- Secondary Actions -->
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="📋 Logdatei" Click="OnOpenLogClicked"
                        Background="#1E293B" Foreground="#CBD5E1" FontSize="12"
                        Padding="12,10" Margin="0,0,8,0" BorderThickness="0" Cursor="Hand"/>

                <Button Content="❌ Beenden" Click="OnExitClicked"
                        Background="#334155" Foreground="#CBD5E1" FontSize="12"
                        Padding="12,10" BorderThickness="0" Cursor="Hand"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
