<Window x:Class="Imaginary.Desktop.Views.SplashScreenWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Imaginary"
        Width="460" Height="480"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        Icon="pack://application:,,,/app.ico">

    <Window.Resources>
        <LinearGradientBrush x:Key="SplashBrandGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#00D2FF" Offset="0.0"/>
            <GradientStop Color="#3B82F6" Offset="0.5"/>
            <GradientStop Color="#D946EF" Offset="1.0"/>
        </LinearGradientBrush>

        <Storyboard x:Key="FadeInStoryboard">
            <DoubleAnimation Storyboard.TargetName="RootBorder"
                             Storyboard.TargetProperty="Opacity"
                             From="0.0" To="1.0" Duration="0:0:0.35">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="ScaleTransform"
                             Storyboard.TargetProperty="ScaleX"
                             From="0.92" To="1.0" Duration="0:0:0.4">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="ScaleTransform"
                             Storyboard.TargetProperty="ScaleY"
                             From="0.92" To="1.0" Duration="0:0:0.4">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>
    </Window.Resources>

    <Border x:Name="RootBorder" Margin="20" CornerRadius="20"
            Background="#070A13"
            BorderBrush="{StaticResource SplashBrandGradient}"
            BorderThickness="1.5"
            Opacity="0"
            RenderTransformOrigin="0.5,0.5">
        <Border.RenderTransform>
            <ScaleTransform x:Name="ScaleTransform" ScaleX="0.92" ScaleY="0.92"/>
        </Border.RenderTransform>
        <Border.Effect>
            <DropShadowEffect Color="#00D2FF" BlurRadius="30" ShadowDepth="0" Opacity="0.4"/>
        </Border.Effect>

        <Grid Margin="20,24,20,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Brand Logo with Text -->
            <Border Grid.Row="0" CornerRadius="12" ClipToBounds="True" Background="Transparent"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <Image Source="pack://application:,,,/Assets/splash_logo.png"
                       Width="300" Height="300"
                       Stretch="Uniform"
                       RenderOptions.BitmapScalingMode="HighQuality"
                       SnapsToDevicePixels="True"
                       UseLayoutRounding="True"/>
            </Border>

            <!-- Subtitle / Tagline -->
            <StackPanel Grid.Row="1" HorizontalAlignment="Center" Margin="0,4,0,16">
                <TextBlock Text="PROFESSIONELLES BILDSTUDIO"
                           FontSize="11.5" FontWeight="Bold"
                           Foreground="#94A3B8"
                           HorizontalAlignment="Center">
                    <TextBlock.Effect>
                        <DropShadowEffect Color="#00D2FF" BlurRadius="6" ShadowDepth="0" Opacity="0.45"/>
                    </TextBlock.Effect>
                </TextBlock>
                <TextBlock Text="Konvertierung • Optimierung • Icon-Studio"
                           FontSize="11" Foreground="#64748B"
                           HorizontalAlignment="Center" Margin="0,3,0,0"/>
            </StackPanel>

            <!-- Glowing animated accent bar -->
            <Border Grid.Row="2" Height="4" CornerRadius="2" Background="#141E30" ClipToBounds="True" Margin="24,0,24,6">
                <ProgressBar IsIndeterminate="True" Height="4" BorderThickness="0"
                             Foreground="{StaticResource SplashBrandGradient}"
                             Background="Transparent"/>
            </Border>
        </Grid>
    </Border>
</Window>
