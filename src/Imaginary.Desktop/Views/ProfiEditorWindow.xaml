<Window x:Class="Imaginary.Desktop.Views.ProfiEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Imaginary – Profi-Modus (RAW-Entwickler &amp; Color-Grading)"
        Height="900" Width="1440"
        MinHeight="650" MinWidth="1100"
        WindowStartupLocation="CenterOwner"
        Icon="pack://application:,,,/app.ico"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        FontFamily="Segoe UI"
        PreviewKeyDown="OnWindowPreviewKeyDown">

    <Window.Resources>
        <!-- Checkerboard brush for transparent/canvas background -->
        <DrawingBrush x:Key="ProfiCheckerboardBrush" Viewport="0,0,16,16" ViewportUnits="Absolute" TileMode="Tile">
            <DrawingBrush.Drawing>
                <DrawingGroup>
                    <GeometryDrawing Brush="#111827">
                        <GeometryDrawing.Geometry>
                            <RectangleGeometry Rect="0,0,16,16"/>
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                    <GeometryDrawing Brush="#0B0F19">
                        <GeometryDrawing.Geometry>
                            <GeometryGroup>
                                <RectangleGeometry Rect="0,0,8,8"/>
                                <RectangleGeometry Rect="8,8,8,8"/>
                            </GeometryGroup>
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                </DrawingGroup>
            </DrawingBrush.Drawing>
        </DrawingBrush>

        <!-- Style for preset pill buttons -->
        <Style x:Key="PresetPillButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#1E293B"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="#334155"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Margin" Value="0,0,6,6"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="PillBorder" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="12" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="PillBorder" Property="Background" Value="#2A3B53"/>
                                <Setter TargetName="PillBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="PillBorder" Property="Background" Value="{DynamicResource AccentBrush}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Category Reset Button Style -->
        <Style x:Key="CategoryResetButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="4,2"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="ToolTip" Value="Diesen Bereich auf Standardwerte zurücksetzen"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ResBorder" Background="Transparent" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ResBorder" Property="Background" Value="#223049"/>
                                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Expander Header Style -->
        <Style x:Key="ProfiExpanderStyle" TargetType="Expander">
            <Setter Property="Background" Value="{DynamicResource SurfaceBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="IsExpanded" Value="True"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Top App Header -->
            <RowDefinition Height="*"/>    <!-- Center Workspace (Canvas + Right Grading Panel) -->
            <RowDefinition Height="Auto"/> <!-- Bottom Status Bar -->
        </Grid.RowDefinitions>

        <!-- 1. TOP HEADER -->
        <Border Grid.Row="0" Background="{DynamicResource SurfaceBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="14,9">
            <DockPanel LastChildFill="True">
                <!-- Right Controls: Zoom & Viewport -->
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                    <!-- Before/After & Split controls -->
                    <ToggleButton x:Name="ToggleBeforeAfter" Content="👁️ Vorher (Taste \)"
                                  Click="OnToggleBeforeAfterClicked" Style="{DynamicResource ToolbarToggleButtonStyle}"
                                  Padding="10,5" Margin="0,0,6,0"
                                  ToolTip="Zeigt das unbehandelte Originalbild zum Direktvergleich"/>
                    <ToggleButton x:Name="ToggleSplitView" Content="🪟 Split-Vergleich"
                                  Click="OnToggleSplitViewClicked" Style="{DynamicResource ToolbarToggleButtonStyle}"
                                  Padding="10,5" Margin="0,0,12,0"
                                  ToolTip="Teilt das Bild für den Vorher/Nachher-Vergleich mit interaktivem Schieberegler"/>

                    <Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" Margin="0,2,10,2"/>

                    <!-- Settings Clipboard & Reset -->
                    <Button Content="📋 Kopieren" Click="OnCopySettingsClicked" Style="{DynamicResource ToolbarButtonStyle}"
                            Padding="8,5" Margin="0,0,4,0" ToolTip="Kopiert alle Entwicklungseinstellungen in den Zwischenspeicher"/>
                    <Button Content="📥 Einfügen" Click="OnPasteSettingsClicked" Style="{DynamicResource ToolbarButtonStyle}"
                            Padding="8,5" Margin="0,0,6,0" ToolTip="Fügt zuvor kopierte Entwicklungseinstellungen ein"/>
                    <Button Content="↺ Alles zurücksetzen" Click="OnResetAllClicked" Style="{DynamicResource ToolbarButtonStyle}"
                            Padding="8,5" Margin="0,0,14,0" ToolTip="Setzt alle Regler auf neutral zurück"/>

                    <!-- Zoom Controls -->
                    <Border Background="{DynamicResource ToolbarBackgroundBrush}" CornerRadius="6"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="4,2">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="-" Click="OnZoomOutClicked" Width="26" Height="26" Padding="0" Style="{DynamicResource ToolbarButtonStyle}"/>
                            <TextBlock x:Name="TextZoomLevel" Text="100%" FontWeight="Bold" FontSize="11.5"
                                       VerticalAlignment="Center" Margin="8,0" Foreground="{DynamicResource AccentBrush}"/>
                            <Button Content="+" Click="OnZoomInClicked" Width="26" Height="26" Padding="0" Style="{DynamicResource ToolbarButtonStyle}"/>
                            <Button Content="1:1" Click="OnZoomResetClicked" Padding="6,2" FontSize="10.5" Style="{DynamicResource ToolbarButtonStyle}" Margin="4,0,0,0"/>
                            <Button Content="Einpassen" Click="OnZoomFitClicked" Padding="6,2" FontSize="10.5" Style="{DynamicResource ToolbarButtonStyle}" Margin="2,0,0,0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Left: Title & File/RAW Info -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="34" Height="34" CornerRadius="8" Background="#0A0E1A"
                            BorderBrush="{DynamicResource BorderFocusBrush}" BorderThickness="1.5" Margin="0,0,12,0">
                        <TextBlock Text="🎛️" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="PROFI-MODUS" FontWeight="Black" FontSize="14" Foreground="{DynamicResource AccentBrush}" Margin="0,0,8,0"/>
                            <Border Background="#1E293B" CornerRadius="4" Padding="6,1" VerticalAlignment="Center" Margin="0,0,8,0">
                                <TextBlock x:Name="TextFormatBadge" Text="RAW / 14-Bit" FontSize="10" FontWeight="Bold" Foreground="#38BDF8"/>
                            </Border>
                            <TextBlock x:Name="TextFileName" Text="Foto.cr2" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        </StackPanel>
                        <TextBlock x:Name="TextDimensions" Text="Lade Bildinformationen..." FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </StackPanel>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- 2. CENTER WORKSPACE: Viewport (Left/Center) & Grading Inspector (Right) -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="385"/>
            </Grid.ColumnDefinitions>

            <!-- Center Viewport & Image Canvas -->
            <Border Grid.Column="0" Background="{StaticResource ProfiCheckerboardBrush}" ClipToBounds="True">
                <Grid>
                    <!-- Scrollable & Zoomable Image Host -->
                    <ScrollViewer x:Name="ViewportScrollViewer" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                                  Background="Transparent" MouseWheel="OnViewportMouseWheel"
                                  MouseDown="OnViewportMouseDown" MouseMove="OnViewportMouseMove" MouseUp="OnViewportMouseUp">
                        <Grid x:Name="ImageHostContainer" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Grid.LayoutTransform>
                                <ScaleTransform x:Name="ViewportScaleTransform" ScaleX="1" ScaleY="1"/>
                            </Grid.LayoutTransform>

                            <!-- Rendered Preview Image -->
                            <Image x:Name="MainDisplayImage" Stretch="None" RenderOptions.BitmapScalingMode="HighQuality"/>

                            <!-- Interactive Split-Line Overlay (visible only when Split View is enabled) -->
                            <Canvas x:Name="SplitOverlayCanvas" Visibility="Collapsed" IsHitTestVisible="False">
                                <Line x:Name="SplitDividerLine" Stroke="#00D2FF" StrokeThickness="2"/>
                                <Border x:Name="SplitHandleBadge" Background="#0EA5E9" CornerRadius="12" Padding="8,3"
                                        BorderBrush="White" BorderThickness="1.5">
                                    <TextBlock Text="↔ Vorher | Nachher" FontSize="10" FontWeight="Bold" Foreground="White"/>
                                </Border>
                            </Canvas>
                        </Grid>
                    </ScrollViewer>

                    <!-- Overlay Toast Message (e.g. 'Original (Vorher)', '100% Zoom') -->
                    <Border x:Name="ToastNotification" Background="#D90F172A" BorderBrush="#38BDF8" BorderThickness="1"
                            CornerRadius="8" Padding="14,8" HorizontalAlignment="Center" VerticalAlignment="Top"
                            Margin="0,20,0,0" Visibility="Collapsed" IsHitTestVisible="False">
                        <TextBlock x:Name="TextToastNotification" Text="Original (Vorher)" FontWeight="Bold" FontSize="13" Foreground="White"/>
                    </Border>

                    <!-- Split Slider Position Controller (Floating at bottom of image canvas when split enabled) -->
                    <Border x:Name="PanelSplitController" Background="#E60F172A" BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1" CornerRadius="8" Padding="12,6" HorizontalAlignment="Center" VerticalAlignment="Bottom"
                            Margin="0,0,0,16" Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Vorher (Original)" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,10,0"/>
                            <Slider x:Name="SliderSplitPosition" Minimum="0" Maximum="100" Value="50" Width="180"
                                    ValueChanged="OnSplitPositionChanged" VerticalAlignment="Center"/>
                            <TextBlock Text="Nachher (Entwickelt)" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" Margin="10,0,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Pixel Inspector / Cursor Loupe (Bottom Left) -->
                    <Border Background="#CC0A0E1A" CornerRadius="6" BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1" Padding="8,4" HorizontalAlignment="Left" VerticalAlignment="Bottom"
                            Margin="12,0,0,12" IsHitTestVisible="False">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border x:Name="BorderPixelColorPreview" Width="14" Height="14" CornerRadius="3"
                                    Background="#808080" BorderBrush="White" BorderThickness="1" Margin="0,0,8,0"/>
                            <TextBlock x:Name="TextPixelInspector" Text="X: - | Y: - | RGB: ---, ---, ---"
                                       FontSize="11" FontFamily="Consolas" Foreground="{DynamicResource TextSecondaryBrush}"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- 3. RIGHT SIDEBAR: PROFESSIONAL GRADING CONTROLS -->
            <Border Grid.Column="1" Background="{DynamicResource SurfaceBackgroundBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1,0,0,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="0,0,0,20">

                        <!-- CARD: LIVE HISTOGRAM -->
                        <Border Background="#0A0E1A" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="14,12">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,8">
                                    <!-- Shadow Clipping Indicator (Left) -->
                                    <ToggleButton x:Name="ToggleShadowClipping" ToolTip="Schatten-Clipping (Unterbelichtung / Reines Schwarz) hervorheben"
                                                  Click="OnToggleClippingClicked" Style="{DynamicResource ToolbarToggleButtonStyle}"
                                                  Padding="4,2" DockPanel.Dock="Left">
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse x:Name="DotShadowClipping" Width="8" Height="8" Fill="#334155" Margin="0,0,4,0"/>
                                            <TextBlock Text="▲ Tiefen" FontSize="10" FontWeight="SemiBold"/>
                                        </StackPanel>
                                    </ToggleButton>

                                    <!-- Highlight Clipping Indicator (Right) -->
                                    <ToggleButton x:Name="ToggleHighlightClipping" ToolTip="Lichter-Clipping (Überbelichtung / Reines Weiß) hervorheben"
                                                  Click="OnToggleClippingClicked" Style="{DynamicResource ToolbarToggleButtonStyle}"
                                                  Padding="4,2" DockPanel.Dock="Right">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="Lichter ▲" FontSize="10" FontWeight="SemiBold" Margin="0,0,4,0"/>
                                            <Ellipse x:Name="DotHighlightClipping" Width="8" Height="8" Fill="#334155"/>
                                        </StackPanel>
                                    </ToggleButton>

                                    <TextBlock Text="HISTOGRAMM (RGB / LUMA)" FontWeight="Bold" FontSize="11"
                                               Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </DockPanel>

                                <!-- Histogram Display Canvas / Image -->
                                <Border Background="#070A14" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="4" Height="105">
                                    <Image x:Name="ImageHistogram" Stretch="Fill" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                                </Border>

                                <!-- Histogram Range Markers -->
                                <Grid Margin="0,4,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Schwarz" FontSize="9.5" Foreground="#64748B" HorizontalAlignment="Left"/>
                                    <TextBlock Grid.Column="1" Text="Tiefen" FontSize="9.5" Foreground="#64748B" HorizontalAlignment="Center"/>
                                    <TextBlock Grid.Column="2" Text="Lichter" FontSize="9.5" Foreground="#64748B" HorizontalAlignment="Center"/>
                                    <TextBlock Grid.Column="3" Text="Weiß" FontSize="9.5" Foreground="#64748B" HorizontalAlignment="Right"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- CARD: 1-CLICK SCHNELL-LOOKS (PRESETS) -->
                        <Border Background="{DynamicResource SurfaceBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="0,0,0,1" Padding="14,10">
                            <StackPanel>
                                <TextBlock Text="1-KLICK LOOKS (PRESETS)" FontWeight="Bold" FontSize="11"
                                           Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,8"/>
                                <WrapPanel>
                                    <Button Content="Original" Tag="Original" Click="OnPresetButtonClicked" Style="{StaticResource PresetPillButtonStyle}"/>
                                    <Button Content="Vivid Pop" Tag="Vivid Pop" Click="OnPresetButtonClicked" Style="{StaticResource PresetPillButtonStyle}"/>
                                    <Button Content="Cinema Teal &amp; Orange" Tag="Cinema Teal &amp; Orange" Click="OnPresetButtonClicked" Style="{StaticResource PresetPillButtonStyle}"/>
                                    <Button Content="Moody Urban" Tag="Moody Urban" Click="OnPresetButtonClicked" Style="{StaticResource PresetPillButtonStyle}"/>
                                    <Button Content="Golden Hour" Tag="Golden Hour" Click="OnPresetButtonClicked" Style="{StaticResource PresetPillButtonStyle}"/>
                                    <Button Content="Arktisch Kühl" Tag="Arktisch Kühl" Click="OnPresetButtonClicked" Style="{StaticResource PresetPillButtonStyle}"/>
                                    <Button Content="Analog 35mm" Tag="Analog / 35mm Vintage" Click="OnPresetButtonClicked" Style="{StaticResource PresetPillButtonStyle}"/>
                                    <Button Content="Dramatisch S/W" Tag="Dramatisch B&amp;W" Click="OnPresetButtonClicked" Style="{StaticResource PresetPillButtonStyle}"/>
                                    <Button Content="HDR Landschaft" Tag="HDR Landschaft" Click="OnPresetButtonClicked" Style="{StaticResource PresetPillButtonStyle}"/>
                                    <Button Content="Porträt Sanft" Tag="Porträt Sanft" Click="OnPresetButtonClicked" Style="{StaticResource PresetPillButtonStyle}"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <!-- EXPANDER 1: BELICHTUNG & DYNAMIK -->
                        <Expander IsExpanded="True" Style="{StaticResource ProfiExpanderStyle}">
                            <Expander.Header>
                                <DockPanel LastChildFill="True">
                                    <Button Content="↺" DockPanel.Dock="Right" Click="OnResetLightClicked" Style="{StaticResource CategoryResetButtonStyle}"/>
                                    <TextBlock Text="☀️ Belichtung &amp; Dynamik" FontWeight="SemiBold" FontSize="12.5"/>
                                </DockPanel>
                            </Expander.Header>
                            <StackPanel Margin="0,8,0,0">
                                <!-- Belichtung -->
                                <DockPanel Margin="0,0,0,2">
                                    <TextBlock Text="Belichtung (EV):" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Cursor="Hand" MouseDown="OnResetExposureClicked" ToolTip="Klicken zum Zurücksetzen"/>
                                    <TextBlock x:Name="ValExposure" Text="0.00 EV" DockPanel.Dock="Right" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                                </DockPanel>
                                <Slider x:Name="SliderExposure" Minimum="-3.0" Maximum="3.0" Value="0" SmallChange="0.05"
                                        ValueChanged="OnSliderAdjustmentChanged" MouseDoubleClick="OnResetExposureClicked" Margin="0,0,0,10"/>

                                <!-- Kontrast -->
                                <DockPanel Margin="0,0,0,2">
                                    <TextBlock Text="Kontrast:" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Cursor="Hand" MouseDown="OnResetContrastClicked" ToolTip="Klicken zum Zurücksetzen"/>
                                    <TextBlock x:Name="ValContrast" Text="0" DockPanel.Dock="Right" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                                </DockPanel>
                                <Slider x:Name="SliderContrast" Minimum="-100" Maximum="100" Value="0"
                                        ValueChanged="OnSliderAdjustmentChanged" MouseDoubleClick="OnResetContrastClicked" Margin="0,0,0,10"/>

                                <!-- Lichter -->
                                <DockPanel Margin="0,0,0,2">
                                    <TextBlock Text="Lichter (Highlights):" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Cursor="Hand" MouseDown="OnResetHighlightsClicked" ToolTip="Klicken zum Zurücksetzen"/>
                                    <TextBlock x:Name="ValHighlights" Text="0" DockPanel.Dock="Right" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                                </DockPanel>
                                <Slider x:Name="SliderHighlights" Minimum="-100" Maximum="100" Value="0"
                                        ValueChanged="OnSliderAdjustmentChanged" MouseDoubleClick="OnResetHighlightsClicked" Margin="0,0,0,10"/>

                                <!-- Tiefen -->
                                <DockPanel Margin="0,0,0,2">
                                    <TextBlock Text="Tiefen (Shadows):" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Cursor="Hand" MouseDown="OnResetShadowsClicked" ToolTip="Klicken zum Zurücksetzen"/>
                                    <TextBlock x:Name="ValShadows" Text="0" DockPanel.Dock="Right" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                                </DockPanel>
                                <Slider x:Name="SliderShadows" Minimum="-100" Maximum="100" Value="0"
                                        ValueChanged="OnSliderAdjustmentChanged" MouseDoubleClick="OnResetShadowsClicked" Margin="0,0,0,10"/>

                                <!-- Weißtöne -->
                                <DockPanel Margin="0,0,0,2">
                                    <TextBlock Text="Weißtöne:" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Cursor="Hand" MouseDown="OnResetWhitesClicked" ToolTip="Klicken zum Zurücksetzen"/>
                                    <TextBlock x:Name="ValWhites" Text="0" DockPanel.Dock="Right" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                                </DockPanel>
                                <Slider x:Name="SliderWhites" Minimum="-100" Maximum="100" Value="0"
                                        ValueChanged="OnSliderAdjustmentChanged" MouseDoubleClick="OnResetWhitesClicked" Margin="0,0,0,10"/>

                                <!-- Schwarztöne -->
                                <DockPanel Margin="0,0,0,2">
                                    <TextBlock Text="Schwarztöne:" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Cursor="Hand" MouseDown="OnResetBlacksClicked" ToolTip="Klicken zum Zurücksetzen"/>
                                    <TextBlock x:Name="ValBlacks" Text="0" DockPanel.Dock="Right" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                                </DockPanel>
                                <Slider x:Name="SliderBlacks" Minimum="-100" Maximum="100" Value="0"
                                        ValueChanged="OnSliderAdjustmentChanged" MouseDoubleClick="OnResetBlacksClicked" Margin="0,0,0,4"/>
                            </StackPanel>
                        </Expander>

                        <!-- EXPANDER 2: FARBE & WEISSABGLEICH -->
                        <Expander IsExpanded="True" Style="{StaticResource ProfiExpanderStyle}">
                            <Expander.Header>
                                <DockPanel LastChildFill="True">
                                    <Button Content="↺" DockPanel.Dock="Right" Click="OnResetColorClicked" Style="{StaticResource CategoryResetButtonStyle}"/>
                                    <TextBlock Text="🎨 Farbe &amp; Weißabgleich" FontWeight="SemiBold" FontSize="12.5"/>
                                </DockPanel>
                            </Expander.Header>
                            <StackPanel Margin="0,8,0,0">
                                <!-- Farbtemperatur -->
                                <DockPanel Margin="0,0,0,2">
                                    <TextBlock Text="Farbtemperatur (Kalt / Warm):" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Cursor="Hand" MouseDown="OnResetTempClicked"/>
                                    <TextBlock x:Name="ValTemperature" Text="0" DockPanel.Dock="Right" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                                </DockPanel>
                                <Slider x:Name="SliderTemperature" Minimum="-100" Maximum="100" Value="0"
                                        ValueChanged="OnSliderAdjustmentChanged" MouseDoubleClick="OnResetTempClicked" Margin="0,0,0,10"/>

                                <!-- Tönung -->
                                <DockPanel Margin="0,0,0,2">
                                    <TextBlock Text="Tönung (Grün / Magenta):" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Cursor="Hand" MouseDown="OnResetTintClicked"/>
                                    <TextBlock x:Name="ValTint" Text="0" DockPanel.Dock="Right" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                                </DockPanel>
                                <Slider x:Name="SliderTint" Minimum="-100" Maximum="100" Value="0"
                                        ValueChanged="OnSliderAdjustmentChanged" MouseDoubleClick="OnResetTintClicked" Margin="0,0,0,10"/>

                                <!-- Dynamik (Vibrance) -->
                                <DockPanel Margin="0,0,0,2">
                                    <TextBlock Text="Dynamik (Vibrance):" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Cursor="Hand" MouseDown="OnResetVibranceClicked" ToolTip="Intelligente Farbsättigung mit Hautton-Schutz"/>
                                    <TextBlock x:Name="ValVibrance" Text="0" DockPanel.Dock="Right" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                                </DockPanel>
                                <Slider x:Name="SliderVibrance" Minimum="-100" Maximum="100" Value="0"
                                        ValueChanged="OnSliderAdjustmentChanged" MouseDoubleClick="OnResetVibranceClicked" Margin="0,0,0,10"/>

                                <!-- Sättigung -->
                                <DockPanel Margin="0,0,0,2">
                                    <TextBlock Text="Sättigung:" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Cursor="Hand" MouseDown="OnResetSaturationClicked"/>
                                    <TextBlock x:Name="ValSaturation" Text="0" DockPanel.Dock="Right" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                                </DockPanel>
                                <Slider x:Name="SliderSaturation" Minimum="-100" Maximum="100" Value="0"
                                        ValueChanged="OnSliderAdjustmentChanged" MouseDoubleClick="OnResetSaturationClicked" Margin="0,0,0,10"/>

                                <!-- Farbton (Hue Shift) -->
                                <DockPanel Margin="0,0,0,2">
                                    <TextBlock Text="Farbton-Verschiebung (Hue):" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Cursor="Hand" MouseDown="OnResetHueClicked"/>
                                    <TextBlock x:Name="ValHueShift" Text="0°" DockPanel.Dock="Right" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                                </DockPanel>
                                <Slider x:Name="SliderHueShift" Minimum="-180" Maximum="180" Value="0"
                                        ValueChanged="OnSliderAdjustmentChanged" MouseDoubleClick="OnResetHueClicked" Margin="0,0,0,4"/>
                            </StackPanel>
                        </Expander>

                        <!-- EXPANDER 3: SCHÄRFE & DETAILS -->
                        <Expander IsExpanded="False" Style="{StaticResource ProfiExpanderStyle}">
                            <Expander.Header>
                                <DockPanel LastChildFill="True">
                                    <Button Content="↺" DockPanel.Dock="Right" Click="OnResetDetailClicked" Style="{StaticResource CategoryResetButtonStyle}"/>
                                    <TextBlock Text="🔍 Schärfe, Klarheit &amp; Details" FontWeight="SemiBold" FontSize="12.5"/>
                                </DockPanel>
                            </Expander.Header>
                            <StackPanel Margin="0,8,0,0">
                                <!-- Klarheit -->
                                <DockPanel Margin="0,0,0,2">
                                    <TextBlock Text="Klarheit (Mitteltonkontrast):" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Cursor="Hand" MouseDown="OnResetClarityClicked"/>
                                    <TextBlock x:Name="ValClarity" Text="0" DockPanel.Dock="Right" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                                </DockPanel>
                                <Slider x:Name="SliderClarity" Minimum="-100" Maximum="100" Value="0"
                                        ValueChanged="OnSliderAdjustmentChanged" MouseDoubleClick="OnResetClarityClicked" Margin="0,0,0,10"/>

                                <!-- Dunst entfernen (Dehaze) -->
                                <DockPanel Margin="0,0,0,2">
                                    <TextBlock Text="Dunst entfernen (Dehaze):" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Cursor="Hand" MouseDown="OnResetDehazeClicked"/>
                                    <TextBlock x:Name="ValDehaze" Text="0" DockPanel.Dock="Right" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                                </DockPanel>
                                <Slider x:Name="SliderDehaze" Minimum="-100" Maximum="100" Value="0"
                                        ValueChanged="OnSliderAdjustmentChanged" MouseDoubleClick="OnResetDehazeClicked" Margin="0,0,0,10"/>

                                <!-- Schärfen -->
                                <DockPanel Margin="0,0,0,2">
                                    <TextBlock Text="Schärfen (Unsharp Mask):" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Cursor="Hand" MouseDown="OnResetSharpenClicked"/>
                                    <TextBlock x:Name="ValSharpen" Text="0" DockPanel.Dock="Right" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                                </DockPanel>
                                <Slider x:Name="SliderSharpen" Minimum="0" Maximum="100" Value="0"
                                        ValueChanged="OnSliderAdjustmentChanged" MouseDoubleClick="OnResetSharpenClicked" Margin="0,0,0,10"/>

                                <!-- Rauschreduzierung -->
                                <DockPanel Margin="0,0,0,2">
                                    <TextBlock Text="Rauschreduzierung:" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Cursor="Hand" MouseDown="OnResetNoiseClicked"/>
                                    <TextBlock x:Name="ValNoiseReduction" Text="0" DockPanel.Dock="Right" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                                </DockPanel>
                                <Slider x:Name="SliderNoiseReduction" Minimum="0" Maximum="100" Value="0"
                                        ValueChanged="OnSliderAdjustmentChanged" MouseDoubleClick="OnResetNoiseClicked" Margin="0,0,0,4"/>
                            </StackPanel>
                        </Expander>

                        <!-- EXPANDER 4: FARB-GRADING / SPLIT-TONING -->
                        <Expander IsExpanded="False" Style="{StaticResource ProfiExpanderStyle}">
                            <Expander.Header>
                                <DockPanel LastChildFill="True">
                                    <Button Content="↺" DockPanel.Dock="Right" Click="OnResetGradingClicked" Style="{StaticResource CategoryResetButtonStyle}"/>
                                    <TextBlock Text="🎞️ Farb-Grading / Split-Toning" FontWeight="SemiBold" FontSize="12.5"/>
                                </DockPanel>
                            </Expander.Header>
                            <StackPanel Margin="0,8,0,0">
                                <!-- Schatten Farbton & Sättigung -->
                                <TextBlock Text="SCHATTEN (TIEFEN)" FontWeight="Bold" FontSize="10.5" Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,4"/>
                                <DockPanel Margin="0,0,0,2">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Border x:Name="SwatchShadowColor" Width="12" Height="12" CornerRadius="2" Background="#1E293B" BorderBrush="White" BorderThickness="1" Margin="0,0,6,0"/>
                                        <TextBlock Text="Schatten Farbton:" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    </StackPanel>
                                    <TextBlock x:Name="ValShadowHue" Text="210°" DockPanel.Dock="Right" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                                </DockPanel>
                                <Slider x:Name="SliderShadowHue" Minimum="0" Maximum="360" Value="210"
                                        ValueChanged="OnSliderAdjustmentChanged" Margin="0,0,0,8"/>

                                <DockPanel Margin="0,0,0,2">
                                    <TextBlock Text="Schatten Sättigung:" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Cursor="Hand" MouseDown="OnResetShadowSatClicked"/>
                                    <TextBlock x:Name="ValShadowSat" Text="0" DockPanel.Dock="Right" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                                </DockPanel>
                                <Slider x:Name="SliderShadowSat" Minimum="0" Maximum="100" Value="0"
                                        ValueChanged="OnSliderAdjustmentChanged" MouseDoubleClick="OnResetShadowSatClicked" Margin="0,0,0,12"/>

                                <!-- Lichter Farbton & Sättigung -->
                                <TextBlock Text="LICHTER (HÖHEN)" FontWeight="Bold" FontSize="10.5" Foreground="#F59E0B" Margin="0,0,0,4"/>
                                <DockPanel Margin="0,0,0,2">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Border x:Name="SwatchHighlightColor" Width="12" Height="12" CornerRadius="2" Background="#1E293B" BorderBrush="White" BorderThickness="1" Margin="0,0,6,0"/>
                                        <TextBlock Text="Lichter Farbton:" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    </StackPanel>
                                    <TextBlock x:Name="ValHighlightHue" Text="35°" DockPanel.Dock="Right" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                                </DockPanel>
                                <Slider x:Name="SliderHighlightHue" Minimum="0" Maximum="360" Value="35"
                                        ValueChanged="OnSliderAdjustmentChanged" Margin="0,0,0,8"/>

                                <DockPanel Margin="0,0,0,2">
                                    <TextBlock Text="Lichter Sättigung:" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Cursor="Hand" MouseDown="OnResetHighlightSatClicked"/>
                                    <TextBlock x:Name="ValHighlightSat" Text="0" DockPanel.Dock="Right" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                                </DockPanel>
                                <Slider x:Name="SliderHighlightSat" Minimum="0" Maximum="100" Value="0"
                                        ValueChanged="OnSliderAdjustmentChanged" MouseDoubleClick="OnResetHighlightSatClicked" Margin="0,0,0,12"/>

                                <!-- Balance -->
                                <DockPanel Margin="0,0,0,2">
                                    <TextBlock Text="Balance (Schatten ↔ Lichter):" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Cursor="Hand" MouseDown="OnResetGradingBalanceClicked"/>
                                    <TextBlock x:Name="ValGradingBalance" Text="0" DockPanel.Dock="Right" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                                </DockPanel>
                                <Slider x:Name="SliderGradingBalance" Minimum="-100" Maximum="100" Value="0"
                                        ValueChanged="OnSliderAdjustmentChanged" MouseDoubleClick="OnResetGradingBalanceClicked" Margin="0,0,0,4"/>
                            </StackPanel>
                        </Expander>

                        <!-- EXPANDER 5: EFFEKTE & VIGNETTE -->
                        <Expander IsExpanded="False" Style="{StaticResource ProfiExpanderStyle}">
                            <Expander.Header>
                                <DockPanel LastChildFill="True">
                                    <Button Content="↺" DockPanel.Dock="Right" Click="OnResetEffectsClicked" Style="{StaticResource CategoryResetButtonStyle}"/>
                                    <TextBlock Text="✨ Effekte &amp; Vignette" FontWeight="SemiBold" FontSize="12.5"/>
                                </DockPanel>
                            </Expander.Header>
                            <StackPanel Margin="0,8,0,0">
                                <!-- Vignette -->
                                <DockPanel Margin="0,0,0,2">
                                    <TextBlock Text="Vignettierung (Dunkel / Hell):" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Cursor="Hand" MouseDown="OnResetVignetteClicked"/>
                                    <TextBlock x:Name="ValVignette" Text="0" DockPanel.Dock="Right" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                                </DockPanel>
                                <Slider x:Name="SliderVignette" Minimum="-100" Maximum="100" Value="0"
                                        ValueChanged="OnSliderAdjustmentChanged" MouseDoubleClick="OnResetVignetteClicked" Margin="0,0,0,10"/>

                                <!-- Filmkorn -->
                                <DockPanel Margin="0,0,0,2">
                                    <TextBlock Text="Filmkorn (Grain):" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Cursor="Hand" MouseDown="OnResetGrainClicked"/>
                                    <TextBlock x:Name="ValGrain" Text="0" DockPanel.Dock="Right" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                                </DockPanel>
                                <Slider x:Name="SliderGrain" Minimum="0" Maximum="100" Value="0"
                                        ValueChanged="OnSliderAdjustmentChanged" MouseDoubleClick="OnResetGrainClicked" Margin="0,0,0,4"/>
                            </StackPanel>
                        </Expander>

                        <!-- EXPANDER 6: TONWERTKURVE -->
                        <Expander IsExpanded="False" Style="{StaticResource ProfiExpanderStyle}">
                            <Expander.Header>
                                <DockPanel LastChildFill="True">
                                    <Button Content="↺" DockPanel.Dock="Right" Click="OnResetCurveClicked" Style="{StaticResource CategoryResetButtonStyle}"/>
                                    <TextBlock Text="📈 Tonwertkurve (Parametrisch)" FontWeight="SemiBold" FontSize="12.5"/>
                                </DockPanel>
                            </Expander.Header>
                            <StackPanel Margin="0,8,0,0">
                                <!-- Kurve: Lichter -->
                                <DockPanel Margin="0,0,0,2">
                                    <TextBlock Text="Lichter:" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Cursor="Hand" MouseDown="OnResetCurveHighlightsClicked"/>
                                    <TextBlock x:Name="ValCurveHighlights" Text="0" DockPanel.Dock="Right" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                                </DockPanel>
                                <Slider x:Name="SliderCurveHighlights" Minimum="-100" Maximum="100" Value="0"
                                        ValueChanged="OnSliderAdjustmentChanged" MouseDoubleClick="OnResetCurveHighlightsClicked" Margin="0,0,0,10"/>

                                <!-- Kurve: Helle Mitteltöne -->
                                <DockPanel Margin="0,0,0,2">
                                    <TextBlock Text="Helle Mitteltöne:" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Cursor="Hand" MouseDown="OnResetCurveLightsClicked"/>
                                    <TextBlock x:Name="ValCurveLights" Text="0" DockPanel.Dock="Right" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                                </DockPanel>
                                <Slider x:Name="SliderCurveLights" Minimum="-100" Maximum="100" Value="0"
                                        ValueChanged="OnSliderAdjustmentChanged" MouseDoubleClick="OnResetCurveLightsClicked" Margin="0,0,0,10"/>

                                <!-- Kurve: Dunkle Mitteltöne -->
                                <DockPanel Margin="0,0,0,2">
                                    <TextBlock Text="Dunkle Mitteltöne:" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Cursor="Hand" MouseDown="OnResetCurveDarksClicked"/>
                                    <TextBlock x:Name="ValCurveDarks" Text="0" DockPanel.Dock="Right" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                                </DockPanel>
                                <Slider x:Name="SliderCurveDarks" Minimum="-100" Maximum="100" Value="0"
                                        ValueChanged="OnSliderAdjustmentChanged" MouseDoubleClick="OnResetCurveDarksClicked" Margin="0,0,0,10"/>

                                <!-- Kurve: Tiefen -->
                                <DockPanel Margin="0,0,0,2">
                                    <TextBlock Text="Tiefen:" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Cursor="Hand" MouseDown="OnResetCurveShadowsClicked"/>
                                    <TextBlock x:Name="ValCurveShadows" Text="0" DockPanel.Dock="Right" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                                </DockPanel>
                                <Slider x:Name="SliderCurveShadows" Minimum="-100" Maximum="100" Value="0"
                                        ValueChanged="OnSliderAdjustmentChanged" MouseDoubleClick="OnResetCurveShadowsClicked" Margin="0,0,0,4"/>
                            </StackPanel>
                        </Expander>

                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- 3. BOTTOM STATUS & ACTION BAR -->
        <Border Grid.Row="2" Background="{DynamicResource SurfaceBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="14,10">
            <DockPanel LastChildFill="True">
                <!-- Action Buttons (Right) -->
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                    <Button Content="Abbrechen" Click="OnCancelClicked" Padding="14,6" Margin="0,0,10,0"
                            Style="{DynamicResource ToolbarButtonStyle}"/>
                    <Button Content="📋 In Zwischenablage" Click="OnCopyToClipboardClicked" Padding="14,6" Margin="0,0,10,0"
                            Style="{DynamicResource ToolbarButtonStyle}" ToolTip="Kopiert das entwickelte Bild in voller Auflösung in die Zwischenablage"/>
                    <Button Content="💾 Als Kopie exportieren..." Click="OnExportAsCopyClicked" Padding="14,6" Margin="0,0,10,0"
                            Style="{DynamicResource ToolbarButtonStyle}" ToolTip="Exportiert das Bild in beliebigem Format (JPEG, PNG, TIFF, WebP, AVIF)"/>
                    <Button Content="💾 Speichern &amp; Anwenden" Click="OnSaveAndApplyClicked" Padding="16,6" FontWeight="Bold"
                            Background="{DynamicResource AccentBrush}" Foreground="White" Style="{DynamicResource ToolbarButtonStyle}"/>
                </StackPanel>

                <!-- Status Info (Left) -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="TextStatusPerformance" Text="Pipeline: SkiaSharp Multithreaded Engine | 60 FPS"
                               FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}"/>
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</Window>