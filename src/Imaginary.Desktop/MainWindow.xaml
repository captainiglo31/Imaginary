<Window x:Class="Imaginary.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:Imaginary.Desktop.ViewModels"
        xmlns:conv="clr-namespace:Imaginary.Desktop.Converters"
        mc:Ignorable="d"
        Title="Imaginary – Bild-Konvertierung &amp; Optimierung"
        Height="840" Width="1240"
        MinHeight="650" MinWidth="950"
        WindowStartupLocation="CenterScreen"
        Icon="pack://application:,,,/app.ico"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        FontFamily="Segoe UI">

    <Window.InputBindings>
        <KeyBinding Gesture="Ctrl+V" Command="{Binding PasteClipboardCommand}"/>
        <KeyBinding Key="F10" Command="{Binding CaptureScreenshotCommand}"/>
        <KeyBinding Gesture="Ctrl+Shift+S" Command="{Binding CaptureScreenshotCommand}"/>
    </Window.InputBindings>

    <Window.Resources>
        <conv:StatusToBrushConverter x:Key="StatusToBrush"/>
        <conv:InverseBooleanConverter x:Key="InverseBool"/>
        <conv:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVis"/>
        <conv:IntToVisibilityConverter x:Key="IntToVis"/>
        <conv:IntToBooleanConverter x:Key="IntToBool"/>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        </Style>

        <Style x:Key="ActionButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>

        <Style x:Key="TabNavigationRadioButtonStyle" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="bd" Background="Transparent" CornerRadius="6" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}"
                                              TextBlock.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource SecondaryButtonBackgroundBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource ActionButtonGradientBrush}"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="{DynamicResource HeaderBackgroundBrush}" Padding="20,12,20,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="2"/>
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0" LastChildFill="True" Margin="0,0,0,12">
                    <!-- Right Actions (Updates & Protokoll) -->
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                        <!-- Update Available Banner Button -->
                        <Button Content="{Binding UpdateBadgeText}" Command="{Binding ShowUpdateDialogCommand}"
                                Visibility="{Binding IsUpdateAvailable, Converter={StaticResource BoolToVis}}"
                                Background="#10B981" Foreground="White" FontWeight="Bold"
                                Padding="12,6" Margin="0,0,10,0" BorderThickness="0" Cursor="Hand"
                                ToolTip="Klicken, um das neue Update herunterzuladen und zu installieren"/>

                        <!-- MCP / KI Button -->
                        <Button Content="🤖 MCP / KI" Command="{Binding SelectTabCommand}" CommandParameter="2"
                                Padding="12,6" Margin="0,0,10,0"
                                Background="{DynamicResource SecondaryButtonBackgroundBrush}"
                                Foreground="{DynamicResource SecondaryButtonForegroundBrush}"
                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                Cursor="Hand" ToolTip="Model Context Protocol (MCP) &amp; KI-Agenten Konfiguration aufrufen"/>

                        <!-- Protokoll / Log Viewer Button -->
                        <Button Content="📋 Protokoll" Command="{Binding OpenLogViewerCommand}"
                                Padding="12,6" Margin="0,0,2,0"
                                Background="{DynamicResource SecondaryButtonBackgroundBrush}"
                                Foreground="{DynamicResource SecondaryButtonForegroundBrush}"
                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                Cursor="Hand" ToolTip="Echtzeit-System- &amp; Fehler-Protokoll anzeigen"/>
                    </StackPanel>

                    <!-- Left Brand & Center Tab Bar -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Logo & Brand Header -->
                        <Border Width="42" Height="42" CornerRadius="10" Margin="0,0,14,0"
                                Background="#0A0E1A" BorderBrush="{DynamicResource BorderFocusBrush}"
                                BorderThickness="1.5" ClipToBounds="True"
                                RenderOptions.BitmapScalingMode="HighQuality">
                            <Image Source="pack://application:,,,/Assets/logo.png" Stretch="Uniform" Margin="2"
                                   RenderOptions.BitmapScalingMode="HighQuality"
                                   RenderOptions.EdgeMode="Aliased"
                                   SnapsToDevicePixels="True"
                                   UseLayoutRounding="True"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,22,0">
                            <TextBlock Text="IMAGINARY" FontSize="19" FontWeight="ExtraBold"
                                       Foreground="{DynamicResource HeaderForegroundBrush}"/>
                            <TextBlock Text="Next-Gen Image &amp; Automation Studio"
                                       FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,1,0,0"/>
                        </StackPanel>

                        <!-- Modern Segmented Tab Bar -->
                        <Border Background="{DynamicResource ToolbarBackgroundBrush}" CornerRadius="8"
                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="3"
                                VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton Content="⚡ Studio &amp; Batch"
                                             IsChecked="{Binding SelectedTabIndex, Converter={StaticResource IntToBool}, ConverterParameter=0, Mode=TwoWay}"
                                             Style="{StaticResource TabNavigationRadioButtonStyle}"/>
                                <RadioButton Content="📁 Hotfolder &amp; Automation"
                                             IsChecked="{Binding SelectedTabIndex, Converter={StaticResource IntToBool}, ConverterParameter=1, Mode=TwoWay}"
                                             Style="{StaticResource TabNavigationRadioButtonStyle}"/>
                                <RadioButton Content="⚙️ Einstellungen"
                                             IsChecked="{Binding SelectedTabIndex, Converter={StaticResource IntToBool}, ConverterParameter=2, Mode=TwoWay}"
                                             Style="{StaticResource TabNavigationRadioButtonStyle}"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </DockPanel>

                <!-- Luminous Accent Line (Cyan -> Magenta) -->
                <Rectangle Grid.Row="1" Fill="{DynamicResource BrandGradientBrush}" HorizontalAlignment="Stretch"/>
            </Grid>
        </Border>

        <!-- Main Content Area with 3 Tabs -->
        <TabControl Grid.Row="1" SelectedIndex="{Binding SelectedTabIndex, Mode=TwoWay}"
                    BorderThickness="0" Background="Transparent" Margin="16,12,16,12">
            <TabControl.ItemContainerStyle>
                <Style TargetType="TabItem">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </Style>
            </TabControl.ItemContainerStyle>

            <!-- Tab 0: ⚡ Studio & Batch -->
            <TabItem>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="380"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

            <!-- Left Panel: Settings & Pinned Action Buttons -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" Padding="0,0,6,0">
                    <StackPanel>

                        <!-- Presets / Profiles -->
                        <GroupBox Header="⚡ Profile / Presets">
                            <StackPanel Margin="0,4,0,0">
                                <ComboBox ItemsSource="{Binding Presets}"
                                          SelectedItem="{Binding SelectedPreset, Mode=TwoWay}"
                                          DisplayMemberPath="Name"
                                          Padding="6,4" FontSize="13" Margin="0,0,0,8"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0" Content="💾 Als Profil speichern" Command="{Binding SaveCurrentAsPresetCommand}"
                                            Padding="6,4" FontSize="11" Style="{DynamicResource ToolbarButtonStyle}"/>
                                    <Button Grid.Column="2" Content="🗑️ Löschen" Command="{Binding DeleteCurrentPresetCommand}"
                                            Padding="6,4" FontSize="11" Style="{DynamicResource ToolbarButtonStyle}" Margin="0"/>
                                </Grid>
                            </StackPanel>
                        </GroupBox>

                        <!-- 1. Format & Metadata -->
                        <GroupBox Header="1. Zielformat &amp; Metadaten">
                            <StackPanel Margin="0,4,0,0">
                                <ComboBox ItemsSource="{Binding AvailableFormats}"
                                          SelectedIndex="{Binding SelectedFormatIndex, Mode=TwoWay}"
                                          Padding="6,4" FontSize="13" Margin="0,0,0,8"/>
                                <CheckBox IsChecked="{Binding StripMetadata, Mode=TwoWay}"
                                          Content="EXIF &amp; GPS Metadaten entfernen"
                                          FontWeight="Normal" ToolTip="Entfernt Kamera-, Standort- und Aufnahmedaten für Datenschutz und kleinere Dateien"/>
                            </StackPanel>
                        </GroupBox>

                        <!-- 2. Size Constraint (Aufklappbar) -->
                        <Expander Header="2. Maximale Dateigröße (Optional)" Style="{DynamicResource ModernCardExpanderStyle}"
                                  IsExpanded="{Binding EnableSizeLimit, Mode=TwoWay}">
                            <StackPanel Margin="0,4,0,0">
                                <CheckBox IsChecked="{Binding EnableSizeLimit, Mode=TwoWay}"
                                          Content="Dateigröße strikt begrenzen"
                                          FontWeight="Normal" Margin="0,0,0,8"/>

                                <Grid Margin="0,0,0,8" IsEnabled="{Binding EnableSizeLimit}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="10"/>
                                        <ColumnDefinition Width="70"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" Text="{Binding SizeLimitValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             Padding="6,4" FontSize="13"/>
                                    <ComboBox Grid.Column="2" ItemsSource="{Binding AvailableUnits}"
                                              SelectedIndex="{Binding SelectedUnitIndex, Mode=TwoWay}"
                                              Padding="6,4" FontSize="13"/>
                                </Grid>

                                <TextBlock Text="Fallback bei verlustfreien Formaten (PNG):" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,2"/>
                                <ComboBox ItemsSource="{Binding AvailableFallbackStrategies}"
                                          SelectedIndex="{Binding SelectedFallbackStrategyIndex, Mode=TwoWay}"
                                          IsEnabled="{Binding EnableSizeLimit}"
                                          Padding="6,4" FontSize="12"/>
                            </StackPanel>
                        </Expander>

                        <!-- 3. Resize & Cropping -->
                        <GroupBox Header="3. Auflösung &amp; Skalierung">
                            <StackPanel Margin="0,4,0,0">
                                <ComboBox ItemsSource="{Binding AvailableResizeModes}"
                                          SelectedIndex="{Binding SelectedResizeModeIndex, Mode=TwoWay}"
                                          Padding="6,4" FontSize="13" Margin="0,0,0,8"/>

                                <!-- Mode 1: Percentage -->
                                <StackPanel Visibility="{Binding SelectedResizeModeIndex, Converter={StaticResource IntToVis}, ConverterParameter=1}" Margin="0,4,0,0">
                                    <DockPanel Margin="0,0,0,4">
                                        <TextBlock Text="Skalierung:" FontSize="12"/>
                                        <TextBlock Text="{Binding ResizePercentage, StringFormat={}{0:N0} %}"
                                                   FontWeight="Bold" HorizontalAlignment="Right"/>
                                    </DockPanel>
                                    <Slider Minimum="1" Maximum="200" Value="{Binding ResizePercentage, Mode=TwoWay}"
                                            TickFrequency="10" IsSnapToTickEnabled="False"/>
                                </StackPanel>

                                <!-- Mode 2, 3, 4: Width & Height -->
                                <StackPanel Margin="0,4,0,0">
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SelectedResizeModeIndex}" Value="2">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding SelectedResizeModeIndex}" Value="3">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding SelectedResizeModeIndex}" Value="4">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Breite (px):" FontSize="11" Margin="0,0,0,2"/>
                                            <TextBox Text="{Binding TargetWidth, Mode=TwoWay, TargetNullValue=''}" Padding="6,4"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Höhe (px):" FontSize="11" Margin="0,0,0,2"/>
                                            <TextBox Text="{Binding TargetHeight, Mode=TwoWay, TargetNullValue=''}" Padding="6,4"/>
                                        </StackPanel>
                                    </Grid>
                                    <CheckBox IsChecked="{Binding MaintainAspectRatio, Mode=TwoWay}"
                                              Content="Seitenverhältnis beibehalten" FontSize="12" Margin="0,0,0,6"/>
                                    <!-- Mode 3 (Pad): Background color -->
                                    <DockPanel Visibility="{Binding SelectedResizeModeIndex, Converter={StaticResource IntToVis}, ConverterParameter=3}">
                                        <TextBlock Text="Randfarbe (Hex):" FontSize="11" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <TextBox Text="{Binding PadColor, Mode=TwoWay}" Width="90" HorizontalAlignment="Left"/>
                                    </DockPanel>
                                </StackPanel>

                                <!-- Mode 5: MaxEdge -->
                                <StackPanel Visibility="{Binding SelectedResizeModeIndex, Converter={StaticResource IntToVis}, ConverterParameter=5}" Margin="0,4,0,0">
                                    <TextBlock Text="Längste Kante (px):" FontSize="11" Margin="0,0,0,2"/>
                                    <TextBox Text="{Binding MaxEdgeLength, Mode=TwoWay, TargetNullValue=''}" Padding="6,4"/>
                                </StackPanel>
                            </StackPanel>
                        </GroupBox>

                        <!-- 4. Watermark (Aufklappbar) -->
                        <Expander Header="4. Wasserzeichen (Optional)" Style="{DynamicResource ModernCardExpanderStyle}"
                                  IsExpanded="{Binding EnableWatermark, Mode=TwoWay}">
                            <StackPanel Margin="0,4,0,0">
                                <CheckBox IsChecked="{Binding EnableWatermark, Mode=TwoWay}"
                                          Content="Wasserzeichen aktivieren"
                                          FontWeight="Normal" Margin="0,0,0,8"/>

                                <StackPanel IsEnabled="{Binding EnableWatermark}">
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <ComboBox Grid.Column="0" ItemsSource="{Binding AvailableWatermarkTypes}"
                                                  SelectedIndex="{Binding SelectedWatermarkTypeIndex, Mode=TwoWay}"
                                                  Padding="6,4" FontSize="12"/>
                                        <ComboBox Grid.Column="2" ItemsSource="{Binding AvailableWatermarkPositions}"
                                                  SelectedIndex="{Binding SelectedWatermarkPositionIndex, Mode=TwoWay}"
                                                  Padding="6,4" FontSize="12"/>
                                    </Grid>

                                    <!-- Text Watermark Options -->
                                    <StackPanel Visibility="{Binding SelectedWatermarkTypeIndex, Converter={StaticResource IntToVis}, ConverterParameter=0}" Margin="0,0,0,8">
                                        <TextBlock Text="Text:" FontSize="11" Margin="0,0,0,2"/>
                                        <TextBox Text="{Binding WatermarkText, Mode=TwoWay}" Padding="6,4" Margin="0,0,0,6"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="8"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="Schriftgröße:" FontSize="11" Margin="0,0,0,2"/>
                                                <TextBox Text="{Binding WatermarkFontSize, Mode=TwoWay}" Padding="6,4"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="Farbe (Hex):" FontSize="11" Margin="0,0,0,2"/>
                                                <TextBox Text="{Binding WatermarkTextColor, Mode=TwoWay}" Padding="6,4"/>
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>

                                    <!-- Image Watermark Options -->
                                    <StackPanel Visibility="{Binding SelectedWatermarkTypeIndex, Converter={StaticResource IntToVis}, ConverterParameter=1}" Margin="0,0,0,8">
                                        <TextBlock Text="Logo-Datei:" FontSize="11" Margin="0,0,0,2"/>
                                        <DockPanel>
                                            <Button DockPanel.Dock="Right" Content="Wählen..." Command="{Binding SelectWatermarkImageCommand}"
                                                    Padding="8,4" Margin="6,0,0,0"/>
                                            <TextBox Text="{Binding WatermarkImagePath, Mode=TwoWay}" Padding="6,4"/>
                                        </DockPanel>
                                    </StackPanel>

                                    <!-- Opacity Slider -->
                                    <DockPanel Margin="0,2,0,0">
                                        <TextBlock Text="Transparenz:" FontSize="11"/>
                                        <TextBlock Text="{Binding WatermarkOpacity, StringFormat={}{0:P0}}"
                                                   FontWeight="Bold" HorizontalAlignment="Right" FontSize="11"/>
                                    </DockPanel>
                                    <Slider Minimum="0.1" Maximum="1.0" Value="{Binding WatermarkOpacity, Mode=TwoWay}"
                                            TickFrequency="0.05" IsSnapToTickEnabled="False"/>
                                </StackPanel>
                            </StackPanel>
                        </Expander>

                    </StackPanel>
                </ScrollViewer>

                <!-- Fixed Bottom Action Buttons (Always Visible!) -->
                <Border Grid.Row="1" Background="{DynamicResource WindowBackgroundBrush}"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="0,10,0,0" Margin="0,6,0,0">
                    <StackPanel>
                        <Button Content="🚀 Konvertierung starten"
                                Command="{Binding StartConversionCommand}"
                                IsEnabled="{Binding CanStart}"
                                Style="{StaticResource ActionButtonStyle}"
                                Background="{DynamicResource ActionButtonGradientBrush}" Foreground="White"
                                Height="44" Margin="0,0,0,6"/>

                        <Button Content="Abbrechen"
                                Command="{Binding CancelConversionCommand}"
                                IsEnabled="{Binding CanCancel}"
                                Style="{StaticResource ActionButtonStyle}"
                                Background="{DynamicResource SecondaryButtonBackgroundBrush}"
                                Foreground="{DynamicResource SecondaryButtonForegroundBrush}"
                                Height="36"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Right Panel: Files and Results -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Toolbar -->
                <Border Grid.Row="0" Background="{DynamicResource ToolbarBackgroundBrush}" CornerRadius="6" Padding="10" Margin="0,0,0,10"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                    <DockPanel>
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                            <Button Content="+ Dateien" Command="{Binding AddFilesCommand}"
                                    Style="{DynamicResource ToolbarButtonStyle}"/>
                            <Button Content="+ Ordner" Command="{Binding AddFolderCommand}"
                                    Style="{DynamicResource ToolbarButtonStyle}"/>
                            <Button Content="📋 Zwischenablage (Strg+V)" Command="{Binding PasteClipboardCommand}"
                                    Style="{DynamicResource ToolbarButtonStyle}"
                                    ToolTip="Fügt ein kopiertes Bild oder Bilddateien aus der Windows-Zwischenablage ein (Strg+V)"/>
                            <Button Content="📸 Screenshot (F10)" Command="{Binding CaptureScreenshotCommand}"
                                    Style="{DynamicResource ToolbarButtonStyle}"
                                    FontWeight="SemiBold"
                                    ToolTip="Bereich aufnehmen und direkt hier einfügen (F10 oder Strg+Shift+S)"/>
                            <Button Content="🔍 Vorher / Nachher" Command="{Binding OpenPreviewCommand}"
                                    IsEnabled="{Binding CanOpenPreview}"
                                    Style="{DynamicResource ToolbarButtonStyle}"
                                    FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}"
                                    ToolTip="Vorher/Nachher-Vergleich mit synchronisiertem Zoom bis 800%"/>
                            <Button Content="✏️ Bearbeiten / Paint" Command="{Binding OpenEditorCommand}"
                                    Style="{DynamicResource ToolbarButtonStyle}"
                                    FontWeight="SemiBold" Foreground="#10B981"
                                    ToolTip="Öffnet das Bild im integrierten Quick-Edit &amp; Paint Studio (Zuschneiden, DSGVO-Blur, Pfeile, Freistellen)"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right">
                            <Button Content="Auswahl entfernen" Command="{Binding RemoveSelectedCommand}"
                                    Style="{DynamicResource ToolbarButtonStyle}"/>
                            <Button Content="Liste leeren" Command="{Binding ClearFilesCommand}"
                                    Style="{DynamicResource ToolbarButtonStyle}" Margin="0"/>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- File Grid & Drag Drop Area -->
                <Border Grid.Row="1" Background="{DynamicResource SurfaceBackgroundBrush}" CornerRadius="6"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                        AllowDrop="True" Drop="OnGridDrop" DragOver="OnGridDragOver">
                    <Grid>
                        <!-- Empty Drop Hint (visible when empty) -->
                        <Border Background="Transparent"
                                Visibility="{Binding HasFiles, Converter={StaticResource InverseBoolToVis}}">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="20">
                                <TextBlock Text="📁" FontSize="48" HorizontalAlignment="Center" Margin="0,0,0,10" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                <TextBlock Text="Bilder oder Ordner hier ablegen" FontSize="18" FontWeight="SemiBold"
                                           HorizontalAlignment="Center" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                <TextBlock Text="Unterstützt JPEG, PNG, WebP, AVIF, GIF, BMP und TIFF" FontSize="12"
                                           Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                <TextBlock Text="💡 Strg+V für Zwischenablage • F10 für Screenshot • Zeilen per Drag &amp; Drop herausziehen"
                                           FontSize="11.5" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" Margin="0,12,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- DataGrid (visible when files loaded) -->
                        <DataGrid ItemsSource="{Binding Files}"
                                  SelectedItem="{Binding SelectedFile, Mode=TwoWay}"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  IsReadOnly="True"
                                  GridLinesVisibility="None"
                                  HeadersVisibility="Column"
                                  RowHeight="36"
                                  Background="{DynamicResource SurfaceBackgroundBrush}"
                                  ToolTip="Doppelklick zum Bearbeiten • Fertige Zeilen per Drag &amp; Drop herausziehen!"
                                  MouseDoubleClick="OnDataGridMouseDoubleClick"
                                  PreviewMouseLeftButtonDown="OnDataGridPreviewMouseLeftButtonDown"
                                  PreviewMouseMove="OnDataGridPreviewMouseMove">
                            <DataGrid.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="✏️ In Paint / Quick-Edit bearbeiten" Command="{Binding OpenEditorCommand}"/>
                                    <MenuItem Header="🔍 Vorher / Nachher Vergleich" Command="{Binding OpenPreviewCommand}" IsEnabled="{Binding CanOpenPreview}"/>
                                    <Separator/>
                                    <MenuItem Header="📋 Aus Zwischenablage einfügen (Strg+V)" Command="{Binding PasteClipboardCommand}"/>
                                    <MenuItem Header="📸 Screenshot aufnehmen (F10)" Command="{Binding CaptureScreenshotCommand}"/>
                                    <Separator/>
                                    <MenuItem Header="🗑️ Aus Liste entfernen" Command="{Binding RemoveSelectedCommand}"/>
                                    <MenuItem Header="🧹 Liste leeren" Command="{Binding ClearFilesCommand}"/>
                                </ContextMenu>
                            </DataGrid.ContextMenu>
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="Status" Width="130">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="4,0">
                                                <Ellipse Width="10" Height="10" Fill="{Binding Status, Converter={StaticResource StatusToBrush}}" Margin="0,0,8,0"/>
                                                <TextBlock Text="{Binding StatusMessage}" FontSize="12" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTextColumn Header="Dateiname" Binding="{Binding FileName}" Width="200"/>
                                <DataGridTextColumn Header="Vorher (Größe)" Binding="{Binding OriginalSizeFormatted}" Width="100"/>
                                <DataGridTextColumn Header="Nachher (Größe)" Binding="{Binding FinalSizeFormatted}" Width="110"/>
                                <DataGridTextColumn Header="Ersparnis" Binding="{Binding SavingsFormatted}" Width="85"/>
                                <DataGridTextColumn Header="Auflösung" Binding="{Binding FinalDimensionsFormatted}" Width="100"/>
                                <DataGridTextColumn Header="Details / Strategie / Warnungen" Binding="{Binding WarningsFormatted}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>

                <!-- Row 2: Ausgabeordner Bar -->
                <Border Grid.Row="2" Background="{DynamicResource ToolbarBackgroundBrush}" CornerRadius="6"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="10,8" Margin="0,10,0,0">
                    <DockPanel LastChildFill="True">
                        <TextBlock Text="📁 Ausgabeordner:" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,10,0"
                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <Button DockPanel.Dock="Right" Content="📂 Öffnen" Command="{Binding OpenOutputDirectoryCommand}"
                                Padding="10,6" Margin="6,0,0,0" ToolTip="Öffnet den Ausgabeordner im Windows Explorer"/>
                        <Button DockPanel.Dock="Right" Content="Wählen..." Command="{Binding SelectOutputDirectoryCommand}"
                                Padding="10,6" Margin="6,0,0,0"/>
                        <TextBox Text="{Binding OutputDirectory, Mode=TwoWay}" VerticalAlignment="Center" Padding="8,5" FontSize="12"/>
                    </DockPanel>
                </Border>
            </Grid>
        </Grid>
            </TabItem>

            <!-- Tab 1: 📁 Hotfolder & Automation -->
            <TabItem>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="450"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left Column: Rules & Master Control -->
                    <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <!-- 1. Master Control Card -->
                            <GroupBox Header="⚡ Hotfolder Status &amp; Steuerung">
                                <StackPanel Margin="0,4,0,0">
                                    <DockPanel Margin="0,0,0,12">
                                        <Ellipse DockPanel.Dock="Left" Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,10,0">
                                            <Ellipse.Style>
                                                <Style TargetType="Ellipse">
                                                    <Setter Property="Fill" Value="#EF4444"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsHotfolderActive}" Value="True">
                                                            <Setter Property="Fill" Value="#10B981"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Ellipse.Style>
                                        </Ellipse>
                                        <TextBlock Text="{Binding HotfolderStatusText}" FontSize="12.5" FontWeight="SemiBold"
                                                   VerticalAlignment="Center" Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap"/>
                                    </DockPanel>

                                    <Button Command="{Binding ToggleHotfolderCommand}" Height="42" Cursor="Hand" BorderThickness="0">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource ActionButtonStyle}">
                                                <Setter Property="Background" Value="{DynamicResource ActionButtonGradientBrush}"/>
                                                <Setter Property="Content" Value="▶️ Überwachung starten"/>
                                                <Setter Property="Foreground" Value="White"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsHotfolderActive}" Value="True">
                                                        <Setter Property="Background" Value="#DC2626"/>
                                                        <Setter Property="Content" Value="⏹️ Überwachung anhalten"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </StackPanel>
                            </GroupBox>

                            <!-- 2. Directories Card -->
                            <GroupBox Header="📂 Ordner-Pfade">
                                <StackPanel Margin="0,4,0,0">
                                    <TextBlock Text="Überwachter Eingangsordner (Hotfolder):" FontSize="11.5"
                                               Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                    <DockPanel Margin="0,0,0,10">
                                        <Button DockPanel.Dock="Right" Content="Wählen..." Command="{Binding SelectHotfolderCommand}"
                                                Padding="8,4" Margin="6,0,0,0" Style="{DynamicResource ToolbarButtonStyle}"/>
                                        <TextBox Text="{Binding HotfolderPath, Mode=TwoWay}" Padding="6,4" FontSize="12"/>
                                    </DockPanel>

                                    <TextBlock Text="Zielordner für optimierte Bilder:" FontSize="11.5"
                                               Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                    <DockPanel Margin="0,0,0,10">
                                        <Button DockPanel.Dock="Right" Content="Wählen..." Command="{Binding SelectHotfolderOutputCommand}"
                                                Padding="8,4" Margin="6,0,0,0" Style="{DynamicResource ToolbarButtonStyle}"/>
                                        <TextBox Text="{Binding HotfolderOutputPath, Mode=TwoWay}" Padding="6,4" FontSize="12"/>
                                    </DockPanel>

                                    <CheckBox IsChecked="{Binding HotfolderIncludeSubdirectories, Mode=TwoWay}"
                                              Content="Auch alle Unterordner überwachen (rekursiv)"
                                              FontWeight="Normal" Margin="0,0,0,4"/>
                                </StackPanel>
                            </GroupBox>

                            <!-- 3. Original File Actions -->
                            <GroupBox Header="🛡️ Verhalten für Originaldateien">
                                <StackPanel Margin="0,4,0,0">
                                    <TextBlock Text="Was soll nach erfolgreicher Konvertierung mit dem Original geschehen?"
                                               FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,8" TextWrapping="Wrap"/>

                                    <RadioButton Content="Original unverändert im Eingangsordner belassen"
                                                 IsChecked="{Binding HotfolderOriginalActionIndex, Converter={StaticResource IntToBool}, ConverterParameter=0, Mode=TwoWay}"
                                                 Margin="0,0,0,8"/>

                                    <RadioButton Content="In Unterordner 'Originale/' verschieben (Empfohlen)"
                                                 IsChecked="{Binding HotfolderOriginalActionIndex, Converter={StaticResource IntToBool}, ConverterParameter=1, Mode=TwoWay}"
                                                 Margin="0,0,0,4"/>
                                    <TextBlock Text="Verhindert erneute Verarbeitung und hält den Eingangsordner sauber."
                                               FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="20,0,0,8"/>

                                    <RadioButton Content="Original nach erfolgreicher Konvertierung löschen"
                                                 IsChecked="{Binding HotfolderOriginalActionIndex, Converter={StaticResource IntToBool}, ConverterParameter=2, Mode=TwoWay}"
                                                 Margin="0,0,0,8"/>
                                </StackPanel>
                            </GroupBox>

                            <!-- 4. Preset Selection for Hotfolder -->
                            <GroupBox Header="⚡ Konvertierungs-Regeln / Profil">
                                <StackPanel Margin="0,4,0,0">
                                    <TextBlock Text="Konvertierungs-Profil für diesen Hotfolder:" FontSize="11.5"
                                               Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                    <ComboBox ItemsSource="{Binding Presets}"
                                              SelectedItem="{Binding HotfolderSelectedPreset, Mode=TwoWay}"
                                              DisplayMemberPath="Name"
                                              Padding="6,4" FontSize="13" Margin="0,0,6,0"/>
                                    <TextBlock Text="Dieses Profil wird auf alle neu erkannten Bilder im Hotfolder angewendet."
                                               FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,6,0,2"/>
                                </StackPanel>
                            </GroupBox>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Right Column: Live Statistics & History Feed -->
                    <Grid Grid.Column="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Stats Bar -->
                        <Border Grid.Row="0" Background="{DynamicResource ToolbarBackgroundBrush}" CornerRadius="8"
                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="14" Margin="0,0,0,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Stat Card 1 -->
                                <Border Grid.Column="0" Background="{DynamicResource SurfaceBackgroundBrush}" CornerRadius="6"
                                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="12,10">
                                    <StackPanel>
                                        <TextBlock Text="HEUTE VERARBEITET" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                        <TextBlock Text="{Binding HotfolderTodayProcessedCount, StringFormat='{}{0} Bilder'}"
                                                   FontSize="22" FontWeight="ExtraBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>

                                <!-- Stat Card 2 -->
                                <Border Grid.Column="2" Background="{DynamicResource SurfaceBackgroundBrush}" CornerRadius="6"
                                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="12,10">
                                    <StackPanel>
                                        <TextBlock Text="SPEICHERPLATZ GESPART" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                        <TextBlock Text="{Binding HotfolderSavedBytesFormatted}"
                                                   FontSize="22" FontWeight="ExtraBold" Foreground="#10B981" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>

                                <Button Grid.Column="3" Content="Statistik zurücksetzen" Command="{Binding ResetHotfolderStatsCommand}"
                                        VerticalAlignment="Center" Margin="14,0,0,0" Padding="8,5" FontSize="11"
                                        Style="{DynamicResource ToolbarButtonStyle}"/>
                            </Grid>
                        </Border>

                        <!-- History Feed -->
                        <Border Grid.Row="1" Background="{DynamicResource SurfaceBackgroundBrush}" CornerRadius="8"
                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="14">
                            <DockPanel LastChildFill="True">
                                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                                    <TextBlock Text="📋 Automatisch verarbeitete Dateien:" FontWeight="Bold" FontSize="13"
                                               Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                    <Button DockPanel.Dock="Right" Content="Verlauf leeren" Command="{Binding ClearHotfolderHistoryCommand}"
                                            Padding="8,3" FontSize="11" Style="{DynamicResource ToolbarButtonStyle}" Margin="0"/>
                                </DockPanel>

                                <DataGrid ItemsSource="{Binding HotfolderHistory}"
                                          AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                                          GridLinesVisibility="None" HeadersVisibility="Column" RowHeight="34"
                                          Background="{DynamicResource SurfaceBackgroundBrush}" BorderThickness="0"
                                          ToolTip="Fertige Dateien können direkt per Drag &amp; Drop herausgezogen werden!"
                                          PreviewMouseLeftButtonDown="OnDataGridPreviewMouseLeftButtonDown"
                                          PreviewMouseMove="OnDataGridPreviewMouseMove">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Uhrzeit" Binding="{Binding FormattedTime}" Width="75"/>
                                        <DataGridTextColumn Header="Eingangsdatei" Binding="{Binding FileName}" Width="200"/>
                                        <DataGridTextColumn Header="Ziel" Binding="{Binding TargetFileName}" Width="200"/>
                                        <DataGridTextColumn Header="Vorher" Binding="{Binding FormattedOriginalSize}" Width="95"/>
                                        <DataGridTextColumn Header="Nachher" Binding="{Binding FormattedFinalSize}" Width="95"/>
                                        <DataGridTextColumn Header="Ersparnis" Binding="{Binding FormattedSavings}" Width="85"/>
                                        <DataGridTextColumn Header="Status" Binding="{Binding StatusText}" Width="*"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </DockPanel>
                        </Border>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- Tab 2: ⚙️ Einstellungen -->
            <TabItem>
                <ScrollViewer VerticalScrollBarVisibility="Auto" MaxWidth="820" HorizontalAlignment="Left">
                    <StackPanel Margin="8,0,0,16">
                        <!-- System & Autostart -->
                        <GroupBox Header="🖥️ System &amp; Hintergrundbetrieb">
                            <StackPanel Margin="0,4,0,0">
                                <CheckBox IsChecked="{Binding IsAutostartEnabled, Mode=TwoWay}"
                                          Content="Mit Windows starten (Autostart)"
                                          FontWeight="SemiBold" FontSize="13" Margin="0,0,0,2"/>
                                <TextBlock Text="Imaginary startet beim Windows-Login automatisch. Keine Administratorrechte erforderlich."
                                           FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="24,0,0,6" TextWrapping="Wrap"/>

                                <CheckBox IsChecked="{Binding StartMinimizedInTray, Mode=TwoWay}"
                                          IsEnabled="{Binding IsAutostartEnabled}"
                                          Content="Beim Autostart minimiert im Infobereich (Tray) starten"
                                          FontWeight="Normal" FontSize="12.5" Margin="24,0,0,2"/>
                                <TextBlock Text="Wenn deaktiviert, öffnet sich das Hauptfenster direkt nach der Windows-Anmeldung sichtbar auf dem Bildschirm."
                                           FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="48,0,0,14" TextWrapping="Wrap"/>

                                <CheckBox IsChecked="{Binding MinimizeToTrayOnClose, Mode=TwoWay}"
                                          Content="Beim Schließen (X) in den Windows-Infobereich (System-Tray) minimieren"
                                          FontWeight="SemiBold" FontSize="13" Margin="0,0,0,2"/>
                                <TextBlock Text="Lässt die Ordnerüberwachung und Hotfolder zuverlässig im Hintergrund aktiv, wenn das Hauptfenster geschlossen wird."
                                           FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="24,0,0,14" TextWrapping="Wrap"/>

                                <Border Background="{DynamicResource CardHeaderBackgroundBrush}" CornerRadius="6"
                                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="12,10" Margin="0,4,0,4">
                                    <DockPanel LastChildFill="True">
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                                            <!-- Status Badge -->
                                            <Border Background="#10B981" CornerRadius="4" Padding="7,3" Margin="0,0,10,0" VerticalAlignment="Center"
                                                    Visibility="{Binding IsExplorerIntegrationEnabled, Converter={StaticResource BoolToVis}}">
                                                <TextBlock Text="✔ Aktiviert" FontSize="11" FontWeight="Bold" Foreground="White"/>
                                            </Border>
                                            <Border Background="#475569" CornerRadius="4" Padding="7,3" Margin="0,0,10,0" VerticalAlignment="Center"
                                                    Visibility="{Binding IsExplorerIntegrationEnabled, Converter={StaticResource InverseBoolToVis}}">
                                                <TextBlock Text="⚪ Nicht aktiv" FontSize="11" FontWeight="Bold" Foreground="White"/>
                                            </Border>

                                            <!-- Action Button -->
                                            <Button Content="{Binding ExplorerIntegrationButtonText}"
                                                    Command="{Binding ToggleExplorerIntegrationCommand}"
                                                    Padding="14,6" FontWeight="Bold" FontSize="12"
                                                    Cursor="Hand"
                                                    Style="{DynamicResource ToolbarButtonStyle}"/>
                                        </StackPanel>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="Windows-Explorer Rechtsklick-Menü" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                            <TextBlock Text="Bilder oder Ordner direkt per Rechtsklick im Windows Explorer mit Imaginary öffnen."
                                                       FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                            </StackPanel>
                        </GroupBox>

                        <!-- Benachrichtigungen -->
                        <GroupBox Header="🔔 Benachrichtigungen">
                            <StackPanel Margin="0,4,0,0">
                                <CheckBox IsChecked="{Binding ShowTrayNotifications, Mode=TwoWay}"
                                          Content="Windows-Benachrichtigungen anzeigen, wenn Hotfolder Dateien optimiert"
                                          FontWeight="SemiBold" FontSize="13" Margin="0,0,0,2"/>
                                <TextBlock Text="Zeigt eine dezente Windows-Toastmeldung bei abgeschlossenen Hintergrund-Konvertierungen an."
                                           FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="24,0,0,4" TextWrapping="Wrap"/>
                            </StackPanel>
                        </GroupBox>

                        <!-- KI & Freistell-Studio (Hintergrund entfernen) -->
                        <GroupBox Header="🧠 KI &amp; Freistell-Studio (Hintergrund entfernen)">
                            <StackPanel Margin="0,4,0,0">
                                <TextBlock Text="Standard-Methode zum Freistellen von Bildern:" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,4"/>
                                <ComboBox ItemsSource="{Binding AvailableBgRemovalModes}"
                                          SelectedIndex="{Binding SelectedBgRemovalModeIndex, Mode=TwoWay}"
                                          Height="30" Margin="0,0,0,10"/>

                                <!-- Model Status & Download Box -->
                                <Border Background="{DynamicResource ToolbarBackgroundBrush}" CornerRadius="6"
                                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="12" Margin="0,0,0,4">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                                                <TextBlock Text="KI-Modell u2netp (Deep Learning, ONNX):" FontWeight="SemiBold" FontSize="12"/>
                                                <TextBlock Text="{Binding AiModelStatusText}" FontWeight="Bold" FontSize="12"
                                                           Foreground="{DynamicResource AccentBrush}" Margin="8,0,0,0"/>
                                            </StackPanel>
                                            <TextBlock Text="Das neuronale Netz segmentiert Personen, Produkte und Objekte vollautomatisch ohne Farbauswahl. Dateigröße ca. 4,7 MB. 100% lokale Offline-Berechnung."
                                                       FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                                            <Button Content="⬇️ KI-Modell herunterladen" Command="{Binding DownloadAiModelCommand}"
                                                    Visibility="{Binding IsAiModelDownloaded, Converter={StaticResource InverseBoolToVis}}"
                                                    IsEnabled="{Binding IsAiModelDownloading, Converter={StaticResource InverseBool}}"
                                                    Style="{DynamicResource ToolbarButtonStyle}" Padding="12,6" FontWeight="SemiBold"/>
                                            <Button Content="🗑️ Modell löschen" Command="{Binding DeleteAiModelCommand}"
                                                    Visibility="{Binding IsAiModelDownloaded, Converter={StaticResource BoolToVis}}"
                                                    Style="{DynamicResource ToolbarButtonStyle}" Padding="10,6" Foreground="#EF4444"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                
                                <!-- Download Progress Bar if downloading -->
                                <ProgressBar Value="{Binding AiModelDownloadProgress}" Minimum="0" Maximum="100" Height="6" Margin="0,4,0,0"
                                             Visibility="{Binding IsAiModelDownloading, Converter={StaticResource BoolToVis}}"/>
                            </StackPanel>
                        </GroupBox>
 
                        <!-- Model Context Protocol (MCP) & KI-Agenten Integration -->
                        <GroupBox Header="🤖 Model Context Protocol (MCP) &amp; KI-Agenten">
                            <StackPanel Margin="0,4,0,0">
                                <!-- Info Header & Badges -->
                                <DockPanel Margin="0,0,0,8">
                                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                                        <Border Background="#6366F1" CornerRadius="4" Padding="6,2" Margin="0,0,4,0">
                                            <TextBlock Text="Claude Desktop" FontSize="11" FontWeight="Bold" Foreground="White"/>
                                        </Border>
                                        <Border Background="#10B981" CornerRadius="4" Padding="6,2" Margin="0,0,4,0">
                                            <TextBlock Text="Cursor" FontSize="11" FontWeight="Bold" Foreground="White"/>
                                        </Border>
                                        <Border Background="#0EA5E9" CornerRadius="4" Padding="6,2" Margin="0,0,4,0">
                                            <TextBlock Text="ChatGPT" FontSize="11" FontWeight="Bold" Foreground="White"/>
                                        </Border>
                                        <Border Background="#EC4899" CornerRadius="4" Padding="6,2">
                                            <TextBlock Text="Antigravity" FontSize="11" FontWeight="Bold" Foreground="White"/>
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="Automatisierte Bildbearbeitung via KI" FontWeight="Bold" FontSize="13" VerticalAlignment="Center"/>
                                </DockPanel>

                                <TextBlock Text="Mit der standardisierten MCP-Schnittstelle können externe KI-Agenten Imaginary als Werkzeug verwenden: Bilder konvertieren, zuschneiden, Hintergründe mit der KI entfernen, sensible Daten DSGVO-konform schwärzen oder verpixeln und Icon-Sets erstellen."
                                           FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,12"/>

                                <!-- 1-Click Action Buttons -->
                                <WrapPanel Margin="0,0,0,12">
                                    <Button Content="🤖 In Claude Desktop installieren (1-Klick)" Command="{Binding InstallClaudeMcpCommand}"
                                            Style="{DynamicResource ToolbarButtonStyle}" Background="{DynamicResource ActionButtonGradientBrush}"
                                            Foreground="White" FontWeight="Bold" Padding="14,8" Margin="0,0,8,6" Cursor="Hand"
                                            ToolTip="Trägt Imaginary vollautomatisch in %APPDATA%\Claude\claude_desktop_config.json ein"/>

                                    <Button Content="📋 Konfiguration kopieren" Command="{Binding CopyMcpConfigCommand}"
                                            Style="{DynamicResource ToolbarButtonStyle}" Padding="12,8" Margin="0,0,8,6" Cursor="Hand"
                                            ToolTip="Kopiert die JSON-Konfiguration in die Windows-Zwischenablage"/>

                                    <Button Content="📂 Claude-Ordner öffnen" Command="{Binding OpenClaudeConfigFolderCommand}"
                                            Style="{DynamicResource ToolbarButtonStyle}" Padding="12,8" Margin="0,0,0,6" Cursor="Hand"
                                            ToolTip="Öffnet den Claude Konfigurationsordner im Windows Explorer"/>
                                </WrapPanel>

                                <!-- JSON Snippet Preview Box -->
                                <TextBlock Text="Konfiguration (claude_desktop_config.json):" FontWeight="SemiBold" FontSize="11.5" Margin="0,0,0,4"/>
                                <Border Background="{DynamicResource ToolbarBackgroundBrush}" CornerRadius="6"
                                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="10" Margin="0,0,0,12">
                                    <TextBox Text="{Binding McpConfigSnippet, Mode=OneWay}"
                                             IsReadOnly="True" BorderThickness="0" Background="Transparent"
                                             Foreground="{DynamicResource AccentBrush}" FontFamily="Consolas, Cascadia Code, Courier New"
                                             FontSize="11.5" TextWrapping="NoWrap" HorizontalScrollBarVisibility="Auto"/>
                                </Border>

                                <!-- Expander for Available Tools -->
                                <Expander Header="🔍 Verfügbare KI-Werkzeuge anzeigen (10 Tools)" IsExpanded="False"
                                          Style="{DynamicResource ModernCardExpanderStyle}" Margin="0,0,0,4">
                                    <StackPanel Margin="4,8,4,4">
                                        <TextBlock Text="Folgende Funktionen stehen angebundenen KIs vollautomatisch zur Verfügung:"
                                                   FontSize="11.5" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                        <TextBlock Text="• inspect_image — Liest Abmessungen, Farbraum, Alphakanal, Format und Dateigröße" FontSize="11" Margin="0,2,0,2"/>
                                        <TextBlock Text="• convert_image — Konvertiert (JPEG, PNG, WebP, AVIF, GIF, BMP, TIFF, ICO) mit Skalierung" FontSize="11" Margin="0,2,0,2"/>
                                        <TextBlock Text="• remove_background — Entfernt Hintergründe via U-2-Net Deep-Learning oder Farb-Keying" FontSize="11" Margin="0,2,0,2"/>
                                        <TextBlock Text="• segment_object_by_region — Schneidet Objekte gezielt innerhalb einer Bounding-Box [x, y, w, h] frei" FontSize="11" Margin="0,2,0,2"/>
                                        <TextBlock Text="• redact_region — DSGVO-Zensur: Schwärzen (blackout), Verpixeln (pixelate), Weichzeichnen (blur)" FontSize="11" Margin="0,2,0,2"/>
                                        <TextBlock Text="• crop_image — Verlustfreier Zuschnitt von Bildbereichen" FontSize="11" Margin="0,2,0,2"/>
                                        <TextBlock Text="• apply_watermark — Text-Wasserzeichen mit Position, Deckkraft und Schriftgröße" FontSize="11" Margin="0,2,0,2"/>
                                        <TextBlock Text="• generate_icon_set — Erzeugt Multi-Resolution Windows .ico-Dateien (16 bis 256 px)" FontSize="11" Margin="0,2,0,2"/>
                                        <TextBlock Text="• check_ai_model — Prüft Installations- und Offline-Status des lokalen KI-Modells" FontSize="11" Margin="0,2,0,2"/>
                                        <TextBlock Text="• download_ai_model — Lädt das U-2-Net KI-Modell (~4.7 MB) bei Bedarf herunter" FontSize="11" Margin="0,2,0,2"/>
                                    </StackPanel>
                                </Expander>
                            </StackPanel>
                        </GroupBox>

                        <!-- Erscheinungsbild & Design -->
                        <GroupBox Header="🎨 Erscheinungsbild">
                            <StackPanel Margin="0,4,0,0">
                                <CheckBox IsChecked="{Binding IsDarkMode, Mode=TwoWay}"
                                          Content="🌙 Dunkles Design (Dark Mode)"
                                          FontWeight="SemiBold" FontSize="13" Margin="0,0,0,2"/>
                                <TextBlock Text="Schaltet die Benutzeroberfläche in das stylische, augenschonende dunkle Design."
                                           FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="24,0,0,4"/>
                            </StackPanel>
                        </GroupBox>

                        <!-- Updates & Info -->
                        <GroupBox Header="🔄 Updates &amp; Info">
                            <StackPanel Margin="0,4,0,0">
                                <CheckBox IsChecked="{Binding CheckForUpdatesOnStartup, Mode=TwoWay}"
                                          Content="Beim Programmstart automatisch nach neuen Versionen suchen"
                                          FontWeight="SemiBold" FontSize="13" Margin="0,0,0,6"/>

                                <CheckBox IsChecked="{Binding CheckForUpdatesPeriodically, Mode=TwoWay}"
                                          Content="Im laufenden Betrieb regelmäßig im Hintergrund nach neuen Versionen suchen"
                                          FontWeight="SemiBold" FontSize="13" Margin="0,0,0,2"/>
                                <TextBlock Text="Prüft alle 4 Stunden im Hintergrund auf neue Releases. Bei neuen Versionen erscheint ein dezenter Hinweis."
                                           FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="24,0,0,10" TextWrapping="Wrap"/>

                                <DockPanel Margin="0,4,0,12">
                                    <Button DockPanel.Dock="Left" Content="🔄 Jetzt nach Updates suchen" Command="{Binding CheckForUpdatesManualCommand}"
                                            Padding="12,6" Style="{DynamicResource ToolbarButtonStyle}" Margin="0,0,14,0"/>
                                    <TextBlock Text="{Binding AppVersionString, StringFormat='Aktuelle Version: {0}'}"
                                               FontWeight="SemiBold" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                </DockPanel>

                                <Border Background="{DynamicResource ToolbarBackgroundBrush}" CornerRadius="6"
                                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="12" Margin="0,4,0,0">
                                    <DockPanel>
                                        <TextBlock Text="IMAGINARY" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource AccentBrush}"/>
                                        <TextBlock Text="• Entwickelt von Pino Wackers • 100% Native C# &amp; SkiaSharp Bild-Engine"
                                                   FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="8,0,0,0"/>
                                    </DockPanel>
                                </Border>
                            </StackPanel>
                        </GroupBox>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <!-- Bottom Status Bar -->
        <Border Grid.Row="2" Background="{DynamicResource SurfaceBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="16,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="220"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="{Binding StatusSummary}" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>

                <!-- Hotfolder Status Badge & Attribution & Updates Link -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0">
                    <!-- Live Hotfolder Badge -->
                    <Border Background="#10B981" CornerRadius="4" Padding="8,3" Margin="0,0,12,0"
                            Visibility="{Binding IsHotfolderActive, Converter={StaticResource BoolToVis}}"
                            Cursor="Hand" ToolTip="Hotfolder ist aktiv. Klicken zum Öffnen des Hotfolder-Tabs.">
                        <Border.InputBindings>
                            <MouseBinding MouseAction="LeftClick" Command="{Binding SelectTabCommand}" CommandParameter="1"/>
                        </Border.InputBindings>
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="8" Height="8" Fill="White" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Hotfolder aktiv" FontSize="11" FontWeight="Bold" Foreground="White"/>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="Entwickelt von Pino Wackers" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <Button Content="🔄 Updates" Command="{Binding CheckForUpdatesManualCommand}"
                            Padding="8,3" FontSize="11" Style="{DynamicResource ToolbarButtonStyle}" Margin="0,0,6,0"
                            ToolTip="Online nach neuen Versionen von Imaginary suchen"/>
                    <Button Content="📋 Protokoll" Command="{Binding OpenLogViewerCommand}"
                            Padding="8,3" FontSize="11" Style="{DynamicResource ToolbarButtonStyle}" Margin="0"
                            ToolTip="Echtzeit-System- &amp; Fehler-Protokoll öffnen"/>
                </StackPanel>

                <ProgressBar Grid.Column="2" Value="{Binding ProgressValue}" Minimum="0" Maximum="100"
                             Height="16" Margin="10,0,0,0"/>
            </Grid>
        </Border>
    </Grid>
</Window>
